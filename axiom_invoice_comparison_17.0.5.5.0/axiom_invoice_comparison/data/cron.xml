<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_invcmp_refresh" model="ir.cron">
        <field name="name">Invoice Comparison Dashboard: nightly refresh</field>
        <field name="model_id" ref="model_x_invcmp_dashboard"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
dashboards = env['x_invcmp_dashboard'].sudo().search([])
if dashboards:
    env.ref('axiom_invoice_comparison.action_invcmp_refresh').sudo().with_context(
        active_model='x_invcmp_dashboard', active_id=dashboards[0].id, active_ids=dashboards.ids).run()
]]></field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.today() + timedelta(days=1)).strftime('%Y-%m-%d 08:15:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>

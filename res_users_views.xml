<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_login_aliases" model="ir.ui.view">
        <field name="name">res.users.form.login.aliases</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Alternative Logins" name="login_aliases" groups="base.group_system">
                    <p class="text-muted">Other addresses this user can sign in with, using the same password - for example one company mailbox per website.</p>
                    <field name="login_alias_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_login_aliases" model="ir.ui.view">
        <field name="name">res.users.form.login.aliases</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Alternative Logins" name="login_aliases" groups="base.group_system">
                    <p class="text-muted">Other addresses this user can sign in with on any website, using the same password - for example one company mailbox per website. Do not use another user's login.</p>
                    <field name="x_login_alias_ids">
                        <tree editable="bottom">
                            <field name="x_name"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_x_login_alias_tree" model="ir.ui.view">
        <field name="name">x_login_alias.tree</field>
        <field name="model">x_login_alias</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="x_name"/>
                <field name="x_user_id"/>
            </tree>
        </field>
    </record>
    <record id="action_x_login_alias" model="ir.actions.act_window">
        <field name="name">Alternative Logins</field>
        <field name="res_model">x_login_alias</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="menu_x_login_alias" name="Alternative Logins" parent="base.menu_users" action="action_x_login_alias" sequence="40" groups="base.group_system"/>
</odoo>

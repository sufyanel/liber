<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.blog.auto.translate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Blog Translation" id="website_blog_auto_translate_settings">
                    <setting id="website_blog_auto_translate_provider"
                             string="Translate blog posts automatically"
                             help="Blog posts are translated the first time a visitor opens them in another website language, and translated again whenever their content changes. No account or API key is needed.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="blog_translate_provider" class="col-lg-3 o_light_label"/>
                                <field name="blog_translate_provider"/>
                            </div>
                            <div class="row" invisible="blog_translate_provider != 'libre'">
                                <label for="blog_translate_libre_url" class="col-lg-3 o_light_label"/>
                                <field name="blog_translate_libre_url"
                                       placeholder="http://localhost:5000/translate"
                                       required="blog_translate_provider == 'libre'"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

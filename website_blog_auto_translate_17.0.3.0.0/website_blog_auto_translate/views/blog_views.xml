<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blog_post_form" model="ir.ui.view">
        <field name="name">blog.post.form.inherit.auto.translate</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='publishing_details']" position="inside">
                <field name="auto_translate"/>
            </xpath>
        </field>
    </record>

    <record id="view_blog_post_list" model="ir.ui.view">
        <field name="name">blog.post.list.inherit.auto.translate</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_list"/>
        <field name="arch" type="xml">
            <field name="is_published" position="after">
                <field name="auto_translate" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_blog_blog_form" model="ir.ui.view">
        <field name="name">blog.blog.form.inherit.auto.translate</field>
        <field name="model">blog.blog</field>
        <field name="inherit_id" ref="website_blog.view_blog_blog_form"/>
        <field name="arch" type="xml">
            <field name="subtitle" position="after">
                <field name="auto_translate"/>
            </field>
        </field>
    </record>
</odoo>

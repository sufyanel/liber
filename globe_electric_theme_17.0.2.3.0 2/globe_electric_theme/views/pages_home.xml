<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- globe_home, built to mockups/globe-electric/full-site/index.html -->
    <template id="globe_home" name="Globe Electric: home">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'homepage'"/>
            <t t-set="globe_hub" t-value="'x_globe_tx_hub_issued' in website and website.x_globe_tx_hub_issued"/>
            <div id="wrap" class="globe-page">

                <section class="globe-hero globe-on-dark">
                    <div class="globe-container">
                        <p class="globe-eyebrow">Transportation · Electrical · Communications · Industrial</p>
                        <h1>Right product. Right spec.<br/><span class="globe-hl">No lead-time surprises.</span></h1>
                        <p class="globe-lede">Globe Electric Supply keeps rail, traffic, and airport systems running. We read the drawing, source to specification, and tell you the moment an order moves — for the infrastructure that can't go dark.</p>
                        <div class="globe-hero-cta">
                            <a class="globe-btn globe-btn-accent" href="/quote">Request a Quote</a>
                            <a class="globe-btn globe-btn-outline" href="tel:+18327912940">Call (832) 791-2940</a>
                        </div>
                        <p class="globe-hero-note">Same-day quotes · Authorized distribution · Nationwide shipping since 1972</p>
                    </div>
                </section>

                <div class="globe-statband">
                    <div class="globe-container">
                        <a class="globe-stat" href="/about-us"><div class="globe-stat-v">Since 1972</div><div class="globe-stat-k">Houston, Texas</div></a>
                        <a class="globe-stat" href="/manufacturers"><div class="globe-stat-v">20+</div><div class="globe-stat-k">Authorized Manufacturers</div></a>
                        <a class="globe-stat" href="/contact"><div class="globe-stat-v">Nationwide</div><div class="globe-stat-k">Shipping &amp; Staging</div></a>
                        <a class="globe-stat" href="/quote"><div class="globe-stat-v">Same-Day</div><div class="globe-stat-k">Quotes</div></a>
                    </div>
                </div>

                <section class="globe-section">
                    <div class="globe-container">
                        <div class="globe-section-head">
                            <p class="globe-eyebrow">How We Work</p>
                            <h2>What you can expect from Globe</h2>
                            <p>Four commitments we make on every order — whether it's a single obsolete relay or a bill-of-material release across a transit program.</p>
                        </div>
                        <div class="globe-pillars">
                            <a class="globe-pillar" href="/capabilities/spec-sourcing"><p class="globe-pillar-num">01</p><h3>Deep Technical Knowledge</h3><p>We read the drawing, not just the part number. Our team works from the specification, cross-references the OEM data, and confirms fit before we quote.</p></a>
                            <a class="globe-pillar" href="/capabilities/reverse-engineering"><p class="globe-pillar-num">02</p><h3>Design Optimization</h3><p>We build custom components and reverse-engineer obsolete parts when the original manufacturer has moved on or the lead time has become unworkable.</p></a>
                            <a class="globe-pillar" href="/quote"><p class="globe-pillar-num">03</p><h3>Collaborative</h3><p>You know the status of your order — and we tell you first when it moves. No chasing, no discovering a slip at the dock.</p></a>
                            <a class="globe-pillar" href="/about-us"><p class="globe-pillar-num">04</p><h3>Reliable</h3><p>Quality product that meets our lead-time commitments. If we commit to a date, that date holds.</p></a>
                        </div>
                    </div>
                </section>

                <section class="globe-section globe-section-white">
                    <div class="globe-container">
                        <div class="globe-section-head">
                            <p class="globe-eyebrow">Solutions</p>
                            <h2>The industries we supply</h2>
                            <p>Five environments where Globe is a working, day-to-day supplier — not a directory listing.</p>
                        </div>
                        <div class="globe-tiles">
                            <a class="globe-tile" href="/solutions/rail-transit"><div class="globe-tile-img"><span>Rail / Transit</span></div><div class="globe-tile-body"><h3>Rail &amp; Transit</h3><p>Signals, communications, and switch components for passenger rail and transit maintenance depots.</p><span class="globe-tile-go">View industry →</span></div></a>
                            <a class="globe-tile" href="/solutions/traffic-highway"><div class="globe-tile-img"><span>Traffic / Highway</span></div><div class="globe-tile-body"><h3>Traffic &amp; Highway</h3><p>Signal heads, controllers, and cabinet hardware for DOT and municipal traffic programs.</p><span class="globe-tile-go">View industry →</span></div></a>
                            <a class="globe-tile" href="/solutions/aviation-airport"><div class="globe-tile-img"><span>Aviation / Airport</span></div><div class="globe-tile-body"><h3>Aviation &amp; Airport</h3><p>Airfield lighting, navaids, and support equipment for airport authorities and civil-works contractors.</p><span class="globe-tile-go">View industry →</span></div></a>
                            <a class="globe-tile" href="/solutions/industrial-electrical"><div class="globe-tile-img"><span>Industrial / Electrical</span></div><div class="globe-tile-body"><h3>Industrial &amp; Electrical</h3><p>Breakers, motor controls, safety switches, lugs, and fittings for plant electrical infrastructure.</p><span class="globe-tile-go">View industry →</span></div></a>
                            <a class="globe-tile" href="/solutions/obsolete-hard-to-find"><div class="globe-tile-img"><span>Obsolete / Hard to Find</span></div><div class="globe-tile-body"><h3>Obsolete &amp; Hard-to-Find</h3><p>Discontinued relays, legacy switchgear, and out-of-production assemblies — sourced, cross-referenced, or reverse-engineered.</p><span class="globe-tile-go">View industry →</span></div></a>
                            <a class="globe-tile" href="/line-card"><div class="globe-tile-img"><span>Full Line Card</span></div><div class="globe-tile-body"><h3>Full Line Card</h3><p>Lighting, rail communications, traffic signals, rail switches, airport lighting, adhesives &amp; sealants, electrical distribution.</p><span class="globe-tile-go">View line card →</span></div></a>
                        </div>
                    </div>
                </section>

                <section class="globe-section">
                    <div class="globe-container">
                        <div class="globe-spotlight globe-on-dark">
                            <div>
                                <p class="globe-eyebrow">The Problem Nobody Else Solves</p>
                                <h2>The part is obsolete.<br/>The system isn't.</h2>
                                <p class="globe-spot-text">When a signal or switch assembly is out of production, the default answer is a multi-month redesign. We do the other thing: identify the original specification, cross-reference what is still available, and where nothing is, reverse-engineer a drop-in replacement.</p>
                                <div style="margin-top:1.75rem"><a class="globe-btn globe-btn-accent" href="/solutions/obsolete-hard-to-find">See how it works</a></div>
                            </div>
                            <div class="globe-spot-panel">
                                <ul>
                                    <li><a href="/capabilities/spec-sourcing"><strong>Drawing-led sourcing</strong> — we work from your specification sheet</a></li>
                                    <li><a href="/solutions/obsolete-hard-to-find"><strong>Cross-reference</strong> against active and legacy manufacturer lines</a></li>
                                    <li><a href="/capabilities/reverse-engineering"><strong>Reverse engineering</strong> for parts with no successor</a></li>
                                    <li><a href="/capabilities/labeled-bom-fulfillment"><strong>BOM fulfillment</strong> — delivered by bill of material, product-labeled</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="globe-section globe-govband">
                    <div class="globe-container globe-govband-grid">
                        <div>
                            <p class="globe-eyebrow">Government &amp; Public Sector</p>
                            <h2>Certified to supply the contracts others can't bid</h2>
                            <p style="color:#4A5058;line-height:1.7;margin-top:.75rem">Supplier-diversity certification is the door-opener for transit, airport, and municipal procurement. Globe holds them, and we hold them across more than one jurisdiction.</p>
                            <div class="globe-badges">
                                <a class="globe-badge" href="/government#mbe"><b>MBE</b> · SBE · WBE — City of Houston</a>
                                <a class="globe-badge" href="/government#sbe"><b>SBE</b> — LA Metro</a>
                                <a class="globe-badge" href="/government#sbe"><b>SBE</b> — Port Houston</a>
                                <a class="globe-badge" href="/government#sbe"><b>SBE</b> — Texas DOT</a>
                                <a class="globe-badge" href="/government#dbe"><b>DBE</b> — Texas (TUCP)</a>
                                <a t-if="globe_hub" class="globe-badge" href="/government#certifications"><b>TX HUB</b> — Texas Comptroller</a>
                            </div>
                            <p class="globe-firmo">DUNS <code>098875727</code> · CAGE <code>0V628</code> · UEI <code>GRRXFG6WEJA3</code><br/>B2G Vendor ID <code>20003354</code> — consistent across all agencies</p>
                            <div style="margin-top:1.75rem"><a class="globe-btn globe-btn-dark" href="/government">Government Capabilities</a></div>
                        </div>
                        <div>
                            <table class="globe-naics">
                                <thead><tr><th>NAICS</th><th>Description</th></tr></thead>
                                <tbody>
                                    <tr><td><a href="/government#codes">423610</a></td><td>Electrical Apparatus &amp; Equipment</td></tr>
                                    <tr><td><a href="/government#codes">423840</a></td><td>Industrial Supplies</td></tr>
                                    <tr><td><a href="/government#codes">423720</a></td><td>Plumbing &amp; Heating Equipment</td></tr>
                                    <tr><td><a href="/government#codes">423860</a></td><td>Transportation Equipment &amp; Supplies</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section class="globe-section">
                    <div class="globe-container">
                        <div class="globe-section-head">
                            <p class="globe-eyebrow">Authorized Distribution</p>
                            <h2>Manufacturers we represent</h2>
                            <p>Genuine authorized distribution — not gray market. Traceable, warrantable, and supported by the manufacturer.</p>
                        </div>
                        <div class="globe-wall">
                            <a href="/manufacturers/sportworks">Sportworks</a>
                            <a href="/manufacturers/avire-rath-janus">Avire / Rath Janus</a>
                            <a href="/manufacturers/swarco">SWARCO</a>
                            <a href="/manufacturers/3m">3M</a>
                            <a href="/manufacturers/nvent">nVent</a>
                            <a href="/manufacturers/siemens">Siemens</a>
                            <a href="/manufacturers/nmc-powerswitch">NMC Powerswitch</a>
                            <a href="/manufacturers/honeywell">Honeywell</a>
                            <a href="/manufacturers/hitachi-rail">Hitachi Rail</a>
                            <a href="/manufacturers/otn-belden">OTN / Belden</a>
                            <a href="/manufacturers/led-smart">LED Smart</a>
                            <a href="/manufacturers/harsco-rail">Harsco Rail</a>
                        </div>
                        <div class="globe-mt"><a class="globe-btn globe-btn-dark" href="/manufacturers">All Manufacturers</a></div>
                    </div>
                </section>

                <!-- Knowledge: Globe's latest published articles; Dale's three topics until any are published -->
                <t t-set="globe_posts" t-value="website.env['blog.post'].search([('is_published', '=', True), ('blog_id.website_id', '=', website.id)], order='post_date desc', limit=3)"/>
                <section class="globe-section globe-section-white">
                    <div class="globe-container">
                        <div class="globe-section-head">
                            <p class="globe-eyebrow">Knowledge Base</p>
                            <h2>Engineering notes from the counter</h2>
                            <p>Written by the people who source the parts — cross-reference help, obsolescence handling, and specification guidance.</p>
                        </div>
                        <div class="globe-posts">
                            <t t-if="globe_posts">
                                <a t-foreach="globe_posts" t-as="p" class="globe-post" t-att-href="p.website_url">
                                    <span class="globe-post-tag" t-esc="(p.tag_ids[:1].name) or 'Knowledge'"/>
                                    <h3 t-esc="p.name"/>
                                    <p t-esc="p.subtitle or ''"/>
                                </a>
                            </t>
                            <t t-else="">
                                <a class="globe-post" href="/resources"><span class="globe-post-tag">Cross-Reference</span><h3>Reading a spec sheet when the OEM part number is dead</h3><p>How to work backwards from a drawing to an available equivalent — and when to stop and reverse-engineer instead.</p></a>
                                <a class="globe-post" href="/resources"><span class="globe-post-tag">Obsolescence</span><h3>Why obsolete isn't the same as unavailable</h3><p>The four outcomes when a part goes out of production, and how to tell which one you are actually in.</p></a>
                                <a class="globe-post" href="/resources"><span class="globe-post-tag">Public Sector</span><h3>What a DBE certification actually unlocks on a transit bid</h3><p>Supplier-diversity goals, counting rules, and what buyers need from you at pre-qualification.</p></a>
                            </t>
                        </div>
                        <div class="globe-mt"><a class="globe-btn globe-btn-dark" href="/resources">All Resources</a></div>
                    </div>
                </section>

                <section class="globe-section globe-locband globe-on-dark">
                    <div class="globe-container">
                        <p class="globe-eyebrow">Where We Are</p>
                        <h2>Houston headquarters</h2>
                        <div class="globe-locgrid">
                            <div class="globe-loc"><a class="globe-loc-city" href="/contact">Houston, TX — Corporate</a><p>20333 State Highway 249, Ste 200<br/>Houston, TX 77070-2613<br/><a href="tel:+18327912940">(832) 791-2940</a> · <a href="mailto:sales@globelectric.com">sales@globelectric.com</a></p></div>
                            <div class="globe-loc"><a class="globe-loc-city" href="/locations">Bulverde, TX</a><p>Regional support for Central Texas transit, municipal, and industrial accounts.</p></div>
                        </div>
                        <a class="globe-btn globe-btn-accent" href="/quote">Request a Quote</a>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>

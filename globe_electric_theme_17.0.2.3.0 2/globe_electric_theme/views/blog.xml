<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Globe Knowledge Base: the same structure as the RBC and Tooling blogs, in
         the Globe brand. Only Globe's own blog is listed on the Globe website. -->
    <template id="globe_blog_index" inherit_id="website_blog.blog_post_short" name="Globe Electric: Knowledge Base" priority="64">
        <xpath expr="//div[@id='o_wblog_posts_loop_container']" position="before">
            <t t-if="'x_globe_theme_active' in website and website.x_globe_theme_active">
                <div class="globe-kb-head">
                    <div>
                        <p class="globe-eyebrow">Knowledge Base</p>
                        <h1>Engineering notes from the counter</h1>
                        <p>Written by the people who source the parts — cross-reference help, obsolescence handling, and specification guidance.</p>
                    </div>
                    <t t-set="globe_view" t-value="request.params.get('view') == 'cards' and 'cards' or 'list'"/>
                    <div class="globe-view-toggle" role="group" aria-label="Layout">
                        <a t-att-href="request.httprequest.path" t-attf-class="#{'active' if globe_view == 'list' else ''}" title="List view" aria-label="List view"><i class="fa fa-th-list"/></a>
                        <a t-att-href="request.httprequest.path + '?view=cards'" t-attf-class="#{'active' if globe_view == 'cards' else ''}" title="Card view" aria-label="Card view"><i class="fa fa-th-large"/></a>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='website_blog.posts_loop']" position="replace">
            <t t-if="'x_globe_theme_active' in website and website.x_globe_theme_active">
                <t t-set="globe_posts_here" t-value="[p for p in posts if p.blog_id.website_id.id == website.id]"/>
                <div t-if="not globe_posts_here" class="globe-kb-empty">
                    <p>New articles are being prepared. In the meantime, <a href="/quote">send us your question</a> or call <a href="tel:+18327912940">(832) 791-2940</a>.</p>
                </div>
                <div t-attf-class="globe-kb-#{globe_view}">
                    <article t-foreach="globe_posts_here" t-as="post" class="globe-kb-row">
                        <t t-set="cp" t-value="post.cover_properties or ''"/>
                        <t t-set="thumb" t-value="cp.split('url(')[1].split(')')[0].replace('&quot;', '').replace(&quot;'&quot;, '') if 'url(' in cp else ''"/>
                        <a t-att-href="post.website_url" class="globe-kb-thumb" t-att-aria-label="post.name">
                            <img t-if="thumb" t-att-src="thumb" t-att-alt="post.name" loading="lazy" class="globe-kb-thumb-img"/>
                            <span t-else="" class="globe-kb-brief">
                                <span class="globe-kb-brief-top"><span class="globe-bolt"/><em>Technical brief</em></span>
                                <strong t-out="post.name"/>
                            </span>
                        </a>
                        <div class="globe-kb-body">
                            <div class="globe-kb-tags"><a t-foreach="post.tag_ids[:2]" t-as="tag" class="globe-post-tag" t-att-href="'/blog/tag/%s' % tag.id" t-out="tag.name"/></div>
                            <h3><a t-att-href="post.website_url" t-out="post.name"/></h3>
                            <p t-if="post.subtitle" class="globe-kb-sub" t-out="post.subtitle"/>
                            <a t-att-href="post.website_url" class="globe-tile-go">Read the note →</a>
                        </div>
                        <time class="globe-kb-date" t-out="post.post_date" t-options="{'widget': 'date'}"/>
                    </article>
                </div>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- Post: compact header with breadcrumbs, tags and the print button; a branded
         report header that only appears on paper -->
    <template id="globe_blog_post" inherit_id="website_blog.blog_post_complete" name="Globe Electric: blog post" priority="64">
        <xpath expr="//section[@id='o_wblog_post_top'][not(contains(@class, 'rbc-post-head'))][not(contains(@class, 'tc-post-head'))]" position="replace">
            <t t-if="'x_globe_theme_active' in website and website.x_globe_theme_active">
                <section id="o_wblog_post_top" class="globe-post-head">
                    <div class="globe-container">
                        <div class="globe-print-brand">
                            <span class="globe-bolt"/>
                            <span class="globe-print-brand-name">Globe Electric Supply Co.</span>
                            <span class="globe-print-brand-meta">Knowledge Base · globelectric.com · (832) 791-2940</span>
                        </div>
                        <nav class="globe-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/resources">Resources</a><span>›</span><a t-att-href="'/blog/%s' % blog_post.blog_id.id">Knowledge Base</a></nav>
                        <div class="globe-kb-tags"><a t-foreach="blog_post.tag_ids" t-as="tag" class="globe-post-tag" t-att-href="'/blog/tag/%s' % tag.id" t-out="tag.name"/></div>
                        <h1 t-field="blog_post.name" id="o_wblog_post_name" placeholder="Article title"/>
                        <div t-field="blog_post.subtitle" id="o_wblog_post_subtitle" class="globe-post-sub" placeholder="Subtitle"/>
                        <div class="globe-post-actions">
                            <button type="button" class="globe-btn globe-btn-dark globe-print-btn" onclick="window.print()"><i class="fa fa-print"/> Print / Save as PDF</button>
                            <a href="/quote" class="globe-btn globe-btn-accent">Ask about this</a>
                        </div>
                    </div>
                </section>
            </t>
            <t t-else="">$0</t>
        </xpath>
        <xpath expr="//section[@id='o_wblog_post_main']" position="after">
            <div t-if="'x_globe_theme_active' in website and website.x_globe_theme_active" class="globe-print-foot">
                Globe Electric Supply Co Inc · 20333 State Highway 249, Ste 200, Houston, TX 77070-2613 · (832) 791-2940 · sales@globelectric.com · DUNS 098875727 · CAGE 0V628
            </div>
        </xpath>
    </template>
</odoo>

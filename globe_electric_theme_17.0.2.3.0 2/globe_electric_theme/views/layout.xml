<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- globe_layout_head: site flag, fonts, Tag Manager, business schema -->
    <template id="globe_layout_head" inherit_id="website.layout" name="Globe Electric: head" priority="64">
        <xpath expr="//html" position="attributes">
            <attribute name="t-att-data-globe-theme">'1' if (website and 'x_globe_theme_active' in website and website.x_globe_theme_active) else None</attribute>
        </xpath>
        <xpath expr="//head" position="inside">
            <t t-if="website and 'x_globe_theme_active' in website and website.x_globe_theme_active">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"/>
                <t t-if="website.x_globe_gtm_id and not editable">
                    <script t-att-data-gtm="website.x_globe_gtm_id">
                        (function(w,d,s,l){var i=d.currentScript.getAttribute('data-gtm');w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer');
                    </script>
                </t>
                <!-- BreadcrumbList on every inner page, built from the address -->
                <t t-if="request and request.httprequest.path not in ('/', '/en', '/es') and not request.httprequest.path.startswith('/web')">
                    <t t-set="globe_base" t-value="(website.domain or request.httprequest.host_url).rstrip('/')"/>
                    <t t-set="globe_base" t-value="globe_base if globe_base.startswith('http') else 'https://' + globe_base"/>
                    <t t-set="globe_parts" t-value="[p for p in request.httprequest.path.strip('/').split('/') if p]"/>
                    <script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "<t t-out="globe_base"/>/"}<t t-foreach="globe_parts" t-as="part">, {"@type": "ListItem", "position": <t t-out="part_index + 2"/>, "name": "<t t-out="part.replace('-', ' ').title()"/>", "item": "<t t-out="globe_base"/>/<t t-out="'/'.join(globe_parts[:part_index + 1])"/>"}</t>]}</script>
                </t>
                <t t-if="request and request.httprequest.path in ('/', '/en', '/es')">
                    <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [
{"@type": "Organization", "@id": "https://globelectric.com/#org", "name": "Globe Electric Supply Co Inc", "url": "https://globelectric.com", "foundingDate": "1972", "email": "sales@globelectric.com", "telephone": "+1-832-791-2940"},
{"@type": "LocalBusiness", "@id": "https://globelectric.com/#houston", "name": "Globe Electric Supply Co Inc", "parentOrganization": {"@id": "https://globelectric.com/#org"}, "url": "https://globelectric.com", "telephone": "+1-832-791-2940", "email": "sales@globelectric.com", "address": {"@type": "PostalAddress", "streetAddress": "20333 State Highway 249, Ste 200", "addressLocality": "Houston", "addressRegion": "TX", "postalCode": "77070-2613", "addressCountry": "US"}, "areaServed": "US"}
]}</script>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-if="website and 'x_globe_theme_active' in website and website.x_globe_theme_active and website.x_globe_gtm_id and not editable">
                <noscript><iframe t-att-src="'https://www.googletagmanager.com/ns.html?id=%s' % website.x_globe_gtm_id" height="0" width="0" style="display:none;visibility:hidden"/></noscript>
            </t>
        </xpath>
    </template>

    <!-- Header: Voltage Yellow top rule, wordmark, navigation, quote button -->
    <template id="globe_layout_header" inherit_id="website.layout" name="Globe Electric: header" priority="64">
        <xpath expr="//header[@id='top'][not(contains(@class, 'o_rbc_header'))][not(contains(@class, 'o_tc_header'))]" position="replace">
            <t t-if="website and 'x_globe_theme_active' in website and website.x_globe_theme_active">
                <header t-if="not no_header" id="top" data-anchor="true" data-name="Header" class="globe-header o_no_autohide_menu">
                    <!-- Odoo's auto-hide-menu script expects a .top_menu inside header#top; without one it throws on every page -->
                    <ul class="top_menu o_globe_menu_stub d-none" aria-hidden="true"/>
                    <nav class="globe-nav">
                        <div class="globe-container globe-nav-inner">
                            <a href="/" class="globe-brand" aria-label="Globe Electric Supply Co. home">
                                <span class="globe-bolt" aria-hidden="true"/>
                                <span class="globe-brand-name">Globe Electric Supply Co.</span>
                            </a>
                            <button class="globe-toggler" type="button" aria-controls="globe_menu" aria-expanded="false" aria-label="Menu" data-globe-toggle="globe_menu">
                                <span/><span/><span/>
                            </button>
                            <div class="globe-menu-wrap" id="globe_menu">
                                <ul class="globe-menu">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <li t-if="submenu.is_visible"><a t-att-href="submenu.url" t-att-target="'_blank' if submenu.new_window else None"><span t-field="submenu.name"/></a></li>
                                    </t>
                                </ul>
                            </div>
                            <a class="globe-phone" href="tel:+18327912940">(832) 791-2940</a>
                        </div>
                    </nav>
                </header>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- globe_layout_footer: one contact block, legal links, copyright -->
    <template id="globe_layout_footer" inherit_id="website.layout" name="Globe Electric: footer" priority="64">
        <xpath expr="//footer[@id='bottom'][not(contains(@class, 'rbc-footer'))][not(contains(@class, 'tc-footer'))]" position="replace">
            <t t-if="website and 'x_globe_theme_active' in website and website.x_globe_theme_active">
                <footer t-if="not no_footer" id="bottom" data-anchor="true" data-name="Footer" class="globe-footer">
                    <div class="globe-container">
                        <div class="globe-fgrid">
                            <div>
                                <div class="globe-brand"><span class="globe-bolt" aria-hidden="true"/><span class="globe-brand-name">Globe Electric Supply Co.</span></div>
                                <p>Distributing transportation, electrical, communications, and industrial products nationwide since 1972.</p>
                            </div>
                            <div>
                                <h4>Company</h4>
                                <ul>
                                    <li><a href="/about-us">About</a></li>
                                    <li><a href="/capabilities">Capabilities</a></li>
                                    <li><a href="/manufacturers">Manufacturers</a></li>
                                    <li><a href="/locations">Locations</a></li>
                                </ul>
                            </div>
                            <div>
                                <h4>Solutions</h4>
                                <ul>
                                    <li><a href="/solutions/rail-transit">Rail &amp; Transit</a></li>
                                    <li><a href="/solutions/traffic-highway">Traffic &amp; Highway</a></li>
                                    <li><a href="/solutions/aviation-airport">Aviation &amp; Airport</a></li>
                                    <li><a href="/solutions/obsolete-hard-to-find">Obsolete Parts</a></li>
                                </ul>
                            </div>
                            <div>
                                <h4>Contact</h4>
                                <ul>
                                    <li><a href="tel:+18327912940">(832) 791-2940</a></li>
                                    <li><a href="mailto:sales@globelectric.com">sales@globelectric.com</a></li>
                                    <li><a href="/government">Government</a></li>
                                    <li><a href="/quote">Request a Quote</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="globe-fbot">
                            <span>© <t t-esc="datetime.date.today().year"/> Globe Electric Supply Co Inc. All rights reserved. · <a href="/privacy">Privacy Policy</a> · <a href="/terms-of-use">Terms</a></span>
                            <span>DUNS 098875727 · CAGE 0V628 · UEI GRRXFG6WEJA3</span>
                        </div>
                    </div>
                </footer>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

</odoo>

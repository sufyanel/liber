<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The website this theme styles. Every Globe rule checks this flag. -->
    <record id="field_website__x_globe_theme_active" model="ir.model.fields">
        <field name="model_id" ref="website.model_website"/>
        <field name="name">x_globe_theme_active</field>
        <field name="field_description">Globe Electric theme</field>
        <field name="ttype">boolean</field>
    </record>
    <!-- Google Tag Manager container, e.g. GTM-XXXXXXX. GA4 uses Odoo's own
         Google Analytics key in Website settings. -->
    <record id="field_website__x_globe_gtm_id" model="ir.model.fields">
        <field name="model_id" ref="website.model_website"/>
        <field name="name">x_globe_gtm_id</field>
        <field name="field_description">Globe: Google Tag Manager ID</field>
        <field name="ttype">char</field>
    </record>
    <!-- Tick the day the Texas HUB certification is issued. Until then the
         handoff's claims gate keeps TX HUB off every page. -->
    <record id="field_website__x_globe_tx_hub_issued" model="ir.model.fields">
        <field name="model_id" ref="website.model_website"/>
        <field name="name">x_globe_tx_hub_issued</field>
        <field name="field_description">Globe: Texas HUB certification issued</field>
        <field name="ttype">boolean</field>
    </record>
</odoo>

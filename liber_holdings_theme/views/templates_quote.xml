<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="quote_page" name="Request Quote">
        <t t-call="website.layout">
            <t t-set="additional_title">Request a Quote | Liber Holdings</t>
            <div id="wrap" class="o_liber_quote_page py-5 bg-light">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="mb-4 text-center">
                                <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Centralized RFQ Desk</span>
                                <h1 class="display-5 fw-bold mb-2">Request an Industrial Quote</h1>
                                <p class="text-muted mx-auto" style="max-width: 580px;">
                                    Submit part requirements for fast availability, volume pricing, or custom engineering across our family of companies: RBC Industrial, Tooling Components, and Globe Electric.
                                </p>
                            </div>

                            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5 bg-white">
                                <t t-set="selected_product" t-value="product or (request.env['product.template'].sudo().browse(int(request.params.get('product_id'))).exists() if (request and str(request.params.get('product_id') or '').isdigit()) else False)"/>
                                <div t-if="selected_product" class="alert alert-secondary d-flex align-items-center mb-4">
                                    <i class="fa fa-info-circle fa-2x text-danger me-3"/>
                                    <div>
                                        <small class="text-uppercase text-muted fw-bold d-block">Requested Item:</small>
                                        <strong><t t-esc="selected_product.display_name"/></strong>
                                        <span t-if="selected_product.default_code" class="badge bg-dark ms-2">SKU: <t t-esc="selected_product.default_code"/></span>
                                    </div>
                                </div>

                                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                    <form id="liber_quote_form" action="/website/form/" method="post" enctype="multipart/form-data"
                                          class="o_mark_required" data-mark="*" data-model_name="crm.lead"
                                          data-success-mode="redirect" data-success-page="/quote-received">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="name" t-att-value="'Quote Request: %s' % (selected_product.name if selected_product else 'General Inquiry')"/>

                                        <div class="s_website_form_rows row g-3">
                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_contact_name">Full Name <span class="text-danger">*</span></label>
                                                <input id="quote_contact_name" type="text" class="form-control s_website_form_input"
                                                       name="contact_name" required="required" placeholder="John Doe"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_partner_name">Company / Organization <span class="text-danger">*</span></label>
                                                <input id="quote_partner_name" type="text" class="form-control s_website_form_input"
                                                       name="partner_name" required="required" placeholder="Acme Industrial Corp"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="email" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_email_from">Business Email <span class="text-danger">*</span></label>
                                                <input id="quote_email_from" type="email" class="form-control s_website_form_input"
                                                       name="email_from" required="required" placeholder="buyer@company.com"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_phone">Direct Phone <span class="text-danger">*</span></label>
                                                <input id="quote_phone" type="tel" class="form-control s_website_form_input"
                                                       name="phone" required="required" placeholder="(915) 555-0123"/>
                                            </div>

                                            <div class="col-12 s_website_form_field" data-type="text" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_description">Part Numbers, Quantities &amp; Requirements <span class="text-danger">*</span></label>
                                                <textarea id="quote_description" class="form-control s_website_form_input" rows="4"
                                                          name="description" required="required"
                                                          placeholder="Please list part numbers, brands (e.g. Raymond, Timken, SKF), required quantities, target delivery dates, or specific technical dimensions..."><t t-if="selected_product">Inquiring for: <t t-esc="selected_product.name"/> (SKU: <t t-esc="selected_product.default_code or 'N/A'"/>)&#10;Quantity needed: </t></textarea>
                                            </div>

                                            <div class="col-12 text-center mt-4">
                                                <a href="#" role="button" class="btn btn-primary btn-lg px-5 py-2 text-uppercase fw-bold s_website_form_send">
                                                    Submit Quote Request <i class="fa fa-arrow-right ms-2"/>
                                                </a>
                                                <span id="s_website_form_result" class="d-block mt-2"/>
                                                <div class="mt-3">
                                                    <small class="text-muted">Or call corporate sales directly: <a href="tel:+18327912535" class="fw-bold text-dark">+1 (832) 791-2535</a></small>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Shown only if the quote page itself fails to render (the route stores the error for "Liber: diagnose /quote") -->
    <template id="quote_page_fallback" name="Liber Quote Page (fallback)">
        <t t-call="website.layout">
            <t t-set="additional_title">Request a Quote | Liber Holdings</t>
            <div id="wrap" class="o_liber_quote_page py-5 bg-light">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="mb-4 text-center">
                                <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Centralized RFQ Desk</span>
                                <h1 class="display-5 fw-bold mb-2">Request an Industrial Quote</h1>
                                <p class="text-muted mx-auto" style="max-width: 580px;">
                                    Submit part requirements for fast availability, volume pricing, or custom engineering across our family of companies: RBC Industrial, Tooling Components, and Globe Electric.
                                </p>
                            </div>

                            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5 bg-white">
                                

                                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                    <form id="liber_quote_form" action="/website/form/" method="post" enctype="multipart/form-data"
                                          class="o_mark_required" data-mark="*" data-model_name="crm.lead"
                                          data-success-mode="redirect" data-success-page="/quote-received">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="name" value="Quote Request: General Inquiry"/>

                                        <div class="s_website_form_rows row g-3">
                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_contact_name">Full Name <span class="text-danger">*</span></label>
                                                <input id="quote_contact_name" type="text" class="form-control s_website_form_input"
                                                       name="contact_name" required="required" placeholder="John Doe"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_partner_name">Company / Organization <span class="text-danger">*</span></label>
                                                <input id="quote_partner_name" type="text" class="form-control s_website_form_input"
                                                       name="partner_name" required="required" placeholder="Acme Industrial Corp"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="email" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_email_from">Business Email <span class="text-danger">*</span></label>
                                                <input id="quote_email_from" type="email" class="form-control s_website_form_input"
                                                       name="email_from" required="required" placeholder="buyer@company.com"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_phone">Direct Phone <span class="text-danger">*</span></label>
                                                <input id="quote_phone" type="tel" class="form-control s_website_form_input"
                                                       name="phone" required="required" placeholder="(915) 555-0123"/>
                                            </div>

                                            <div class="col-12 s_website_form_field" data-type="text" data-name="Field">
                                                <label class="form-label fw-semibold" for="quote_description">Part Numbers, Quantities &amp; Requirements <span class="text-danger">*</span></label>
                                                <textarea id="quote_description" class="form-control s_website_form_input" rows="4"
                                                          name="description" required="required"
                                                          placeholder="Please list part numbers, brands (e.g. Raymond, Timken, SKF), required quantities, target delivery dates, or specific technical dimensions..."></textarea>
                                            </div>

                                            <div class="col-12 text-center mt-4">
                                                <a href="#" role="button" class="btn btn-primary btn-lg px-5 py-2 text-uppercase fw-bold s_website_form_send">
                                                    Submit Quote Request <i class="fa fa-arrow-right ms-2"/>
                                                </a>
                                                <span id="s_website_form_result" class="d-block mt-2"/>
                                                <div class="mt-3">
                                                    <small class="text-muted">Or call corporate sales directly: <a href="tel:+18327912535" class="fw-bold text-dark">+1 (832) 791-2535</a></small>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <record id="quote_page_record" model="website.page">
        <field name="name">Request Quote</field>
        <field name="website_published" eval="True"/>
        <field name="url">/quote</field>
        <field name="view_id" ref="quote_page"/>
    </record>

    <!-- Dedicated Quote Confirmation / Thank You Page (resolves Dale's 404 issue) -->
    <template id="quote_received_page" name="Quote Request Received">
        <t t-call="website.layout">
            <t t-set="additional_title">Quote Request Received | Liber Holdings</t>
            <div id="wrap" class="py-5 bg-light min-vh-75 d-flex align-items-center">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-7 text-center">
                            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                                <div class="mb-4">
                                    <div class="d-inline-flex p-3 rounded-circle bg-success bg-opacity-10 text-success mb-3">
                                        <i class="fa fa-check-circle fa-4x"/>
                                    </div>
                                    <h1 class="display-6 fw-bold mb-2">Quote Request Received</h1>
                                    <p class="text-muted lead">
                                        Thank you for your submission. Your RFQ has been routed to our specialized industrial sourcing team.
                                    </p>
                                </div>

                                <div class="alert alert-light border text-start p-3 mb-4">
                                    <h6 class="fw-bold mb-2"><i class="fa fa-clock-o text-danger me-2"/>What happens next?</h6>
                                    <ul class="small text-muted mb-0 ps-3">
                                        <li>Our applications team will check real-time stock across RBC Industrial, Tooling Components, and vendor partner warehouses.</li>
                                        <li>You will receive formal line-item pricing and lead time via email within 2 to 4 business hours.</li>
                                        <li>For immediate order assistance or urgent line-down situations, please call our expedited desk at <strong>+1 (832) 791-2535</strong>.</li>
                                    </ul>
                                </div>

                                <div class="d-flex flex-wrap justify-content-center gap-3">
                                    <t t-set="liber_holding_site" t-value="website and 'liber' in (website.name or '').lower() and 'industrial' not in (website.name or '').lower() and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active))"/>
                                    <a t-if="not liber_holding_site" href="/shop" class="btn btn-outline-dark px-4 py-2">
                                        <i class="fa fa-search me-1"/> Browse Parts Catalog
                                    </a>
                                    <a t-else="" href="/#companies" class="btn btn-outline-dark px-4 py-2">
                                        <i class="fa fa-building-o me-1"/> Our Operating Companies
                                    </a>
                                    <a href="/" class="btn btn-primary px-4 py-2">
                                        <i class="fa fa-home me-1"/> Return to Home
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <record id="quote_received_page_record" model="website.page">
        <field name="name">Quote Request Received</field>
        <field name="website_published" eval="True"/>
        <field name="url">/quote-received</field>
        <field name="view_id" ref="quote_received_page"/>
    </record>



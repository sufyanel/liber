<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brands We Represent Page -->
    <template id="brands_page" name="Brands We Represent">
        <t t-call="website.layout">
            <t t-set="additional_title">Brands We Represent | Liber Holdings</t>
            <div id="wrap" class="o_liber_brands_page">
                <!-- Hero Header -->
                <section class="py-5 text-white bg-dark" style="background: linear-gradient(135deg, #1A1C1E 0%, #2C3035 100%);">
                    <div class="container py-4">
                        <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Authorized Industrial Network</span>
                        <h1 class="display-4 fw-bold mb-2">Brands We Represent</h1>
                        <p class="lead opacity-90" style="max-width: 720px;">
                            Liber Holdings distributes premier domestic and international brands across our operating companies:
                            RBC Industrial, Tooling Components, and Globe Electric Supply.
                        </p>
                    </div>
                </section>

                <!-- Brand Portfolios by Category -->
                <section class="py-5 bg-white">
                    <div class="container">
                        <!-- Die Springs & Press Tooling -->
                        <div class="mb-5 pb-4 border-bottom">
                            <div class="d-flex align-items-center mb-3">
                                <span class="p-2 bg-danger bg-opacity-10 text-danger rounded me-3"><i class="fa fa-cogs fa-2x"/></span>
                                <div>
                                    <h2 class="h3 fw-bold mb-0">Die Springs &amp; Press Tooling</h2>
                                    <small class="text-muted">Distributed nationwide via <strong>Tooling Components</strong> (Union City, PA)</small>
                                </div>
                            </div>
                            <div class="row g-4 mt-1">
                                <div class="col-md-6 col-lg-3">
                                    <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                                        <h5 class="fw-bold text-dark mb-1">Raymond</h5>
                                        <span class="badge bg-secondary mb-2 align-self-start">Springs &amp; Tooling</span>
                                        <p class="small text-muted mb-0">Heavy-duty die springs, high-deflection springs, and standard die accessories for stamping operations.</p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                                        <h5 class="fw-bold text-dark mb-1">Danly</h5>
                                        <span class="badge bg-secondary mb-2 align-self-start">Press Sets &amp; Hardware</span>
                                        <p class="small text-muted mb-0">Precision die sets, guide posts, bushings, bronze plates, and precision hardware for metalworking dies.</p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                                        <h5 class="fw-bold text-dark mb-1">Bordeon</h5>
                                        <span class="badge bg-secondary mb-2 align-self-start">Mechanical Springs</span>
                                        <p class="small text-muted mb-0">High-performance industrial springs engineered for extended cycle life under severe mechanical loads.</p>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                                        <h5 class="fw-bold text-dark mb-1">Lempco</h5>
                                        <span class="badge bg-secondary mb-2 align-self-start">Rotary Bushings</span>
                                        <p class="small text-muted mb-0">Precision ball bearing die sets, rotocon bushings, and guiding components for high-speed stamping.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bearings & Mechanical Power Transmission -->
                        <style>
    /* only needed at desktop 4-up, where unequal copy length would leave
       ragged card bottoms. Safe to drop — the block still renders correctly. */
    @media (min-width: 992px) { .liber-brands-pt .card p { min-height: 4.5em; } }
</style>

<div class="mb-5 pb-4 border-bottom liber-brands-pt">
    <div class="d-flex align-items-center mb-3">
        <span class="p-2 bg-danger bg-opacity-10 text-danger rounded me-3"><i class="fa fa-circle-o-notch fa-2x"></i></span>
        <div>
            <h2 class="h3 fw-bold mb-0">Bearings, Seals &amp; Power Transmission</h2>
            <small class="text-muted">Distributed nationwide via <strong>RBC Industrial</strong> (El Paso, TX)</small>
        </div>
    </div>
    <div class="row g-4 mt-1">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-circle-o-notch"></i></span>
                    <h5 class="fw-bold text-dark mb-0">SKF</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Bearings &amp; Seals</span>
                <p class="small text-muted mb-0">Ball, roller and mounted bearings, lubrication systems and Chicago Rawhide seals.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-dot-circle-o"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Timken</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Bearings &amp; Seals</span>
                <p class="small text-muted mb-0">Tapered and cylindrical roller bearings, Fafnir machine-tool bearings, and National oil seals.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-hdd-o"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Sealmaster</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Mounted Bearings</span>
                <p class="small text-muted mb-0">Pillow blocks, flanged units and rod ends for food, beverage and aggregate duty.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-link"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Rexnord</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Mounted Bearings &amp; Couplings</span>
                <p class="small text-muted mb-0">Link-Belt housed units, pillow blocks and Thomas disc couplings for heavy drives.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-bullseye"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Browning</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Sheaves, Bushings &amp; V-Belts</span>
                <p class="small text-muted mb-0">V-belts, sheaves, QD and split-taper bushings, and mounted bearings for fan drives.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-bars"></i></span>
                    <h5 class="fw-bold text-dark mb-0">ContiTech · Bando</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Timing Belts &amp; Sprockets</span>
                <p class="small text-muted mb-0">SilentSync and Eagle synchronous belts, timing sprockets and precision drive belts.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-cog"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Martin Sprocket</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Sprockets &amp; Gears</span>
                <p class="small text-muted mb-0">Roller chain sprockets, spur gears, timing pulleys and bulk screw conveyors.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-chain"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Diamond Chain <small class="text-muted fw-normal">(Timken)</small></h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Roller Chain</span>
                <p class="small text-muted mb-0">ANSI and engineered roller chain, attachment chain and connecting links for drives.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-cubes"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Grove Gear</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Gear Reducers</span>
                <p class="small text-muted mb-0">Worm, helical and shaft-mounted gear reducers for conveyor and process duty.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-cogs"></i></span>
                    <h5 class="fw-bold text-dark mb-0">SEW-Eurodrive · Nord</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Gearmotors &amp; Drives</span>
                <p class="small text-muted mb-0">Integral gearmotors, right-angle drives and modular drive packages rated up to 200 hp.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-bolt"></i></span>
                    <h5 class="fw-bold text-dark mb-0">Leeson · Marathon · Techtop</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Motors &amp; Drives</span>
                <p class="small text-muted mb-0">General-purpose, severe-duty and washdown AC motors and NEMA premium TEFC motors.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center mb-1">
                    <span class="text-danger me-2"><i class="fa fa-life-ring"></i></span>
                    <h5 class="fw-bold text-dark mb-0">McGill</h5>
                </div>
                <span class="badge bg-secondary mb-2 align-self-start">Cam Followers &amp; Bearings</span>
                <p class="small text-muted mb-0">Cam followers, track rollers and mounted bearings for cam-driven and indexing machinery.</p>
            </div>
        </div>

    </div>
</div>

                        <!-- Corporate Inquiry Card -->
                        <div class="p-4 p-md-5 rounded-4 bg-light border text-center">
                            <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Distribution &amp; Sourcing Inquiries</span>
                            <h3 class="display-6 fw-bold mb-2">Need Direct Parts Sourcing or Vendor Partnership?</h3>
                            <p class="text-muted lead mx-auto mb-4" style="max-width: 600px;">
                                Contact our corporate sales engineers for product crosses, specialized engineering specifications, or volume blanket purchase agreements.
                            </p>
                            <div class="d-flex flex-wrap justify-content-center gap-3">
                                <a t-att-href="'/request-quote' if (website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active))) else '/quote'" class="btn btn-primary btn-lg px-4 py-2 text-uppercase fw-bold">
                                    Request a Quote <i class="fa fa-arrow-right ms-1"/>
                                </a>
                                <a href="/contactus" class="btn btn-outline-dark btn-lg px-4 py-2 text-uppercase fw-bold">
                                    Contact Corporate Office
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="brands_page_record" model="website.page">
        <field name="name">Brands We Represent</field>
        <field name="website_published" eval="True"/>
        <field name="url">/brands</field>
        <field name="view_id" ref="brands_page"/>
    </record>

</odoo>
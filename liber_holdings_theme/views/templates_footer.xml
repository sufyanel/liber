<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liber Holdings Main Corporate Footer -->
    <template id="footer_liber" inherit_id="website.footer_custom" name="Liber Footer" priority="50">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="o_liber_footer oe_structure oe_structure_solo bg-dark text-white pt-5 pb-4" t-ignore="true" data-name="Footer">
                <div class="container">
                    <div class="row gy-4 align-items-start">
                        <!-- Col 1: Holding Group Identity -->
                        <div class="col-md-6 col-lg-4">
                            <h4 class="o_liber_footer_brand text-uppercase fw-bold text-white mb-2"><t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Liber Industrial</t><t t-else="">Liber Holdings</t></h4>
                            <span class="badge bg-danger mb-3 px-2 py-1 small text-uppercase text-wrap text-start lh-sm" style="white-space: normal; max-width: 100%; display: inline-block;"><t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Est. 2018 • SDVOSB · Service-Disabled Veteran-Owned Small Business</t><t t-else="">Est. 2016 • Veteran-Owned</t></span>
                            <p class="text-light opacity-75 small mb-3">
                                <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Industrial MRO supply and specialty chemical distribution - a Liber Holdings company based in Bulverde, Texas.</t><t t-else="">Industrial distribution and precision component sourcing holding company. Serving production plants, aerospace, stamping, and heavy industrial facilities across North America.</t>
                            </p>
                            <div class="small text-light opacity-75 mb-1">
                                <i class="fa fa-map-marker text-danger me-2"/> <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">30131 Bulverde Ln, #370, Bulverde, TX 78163</t><t t-else="">3950 Doniphan Dr, Ste P, El Paso, TX 79922</t>
                            </div>
                            <div class="small text-light opacity-75">
                                <i class="fa fa-phone text-danger me-2"/> <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))"><a href="tel:+18327647979" class="text-white text-decoration-none">+1 (832) 764-7979</a></t><t t-else=""><a href="tel:+18327912535" class="text-white text-decoration-none">+1 (832) 791-2535</a></t>
                            </div>
                        </div>

                        <!-- Col 2: Family of Operating Companies -->
                        <div class="col-6 col-lg-3">
                            <h5 class="text-uppercase fw-bold text-danger small tracking-wider mb-3">Operating Subsidiaries</h5>
                            <ul class="list-unstyled mb-0 small text-light opacity-75">
                                <li class="mb-2">
                                    <a t-attf-href="https://www.rbc-industrial.com" target="_blank" rel="noopener" class="d-block text-white text-decoration-none o_liber_sub_link">RBC Industrial</a>
                                    Bearings, Power Transmission &amp; MRO
                                </li>
                                <li class="mb-2">
                                    <a t-attf-href="https://www.toolingcomponent.com" target="_blank" rel="noopener" class="d-block text-white text-decoration-none o_liber_sub_link">Tooling Components</a>
                                    Die Springs &amp; Press Tooling (PA)
                                </li>
                                <li class="mb-2">
                                    <a t-attf-href="https://www.globeelectricsupply.com" target="_blank" rel="noopener" class="d-block text-white text-decoration-none o_liber_sub_link">Globe Electric Supply</a>
                                    Commercial &amp; Industrial Electrical
                                </li>
                                <li class="mb-0">
                                    <a t-attf-href="https://www.liberindustrial.com" target="_blank" rel="noopener" class="d-block text-white text-decoration-none o_liber_sub_link">Liber Industrial</a>
                                    Integrated MRO Supply (TX)
                                </li>
                            </ul>
                        </div>

                        <!-- Col 3: Corporate & Governance -->
                        <div class="col-6 col-lg-2">
                            <h5 class="text-uppercase fw-bold text-danger small tracking-wider mb-3">Corporate</h5>
                            <ul class="list-unstyled mb-0 small">
                                <li class="mb-2"><a href="/about-us" class="text-light opacity-75 text-decoration-none">Company History</a></li>
                                <li class="mb-2"><a href="/#companies" class="text-light opacity-75 text-decoration-none">Family of Companies</a></li>
                                <li class="mb-2"><a href="/brands" class="text-light opacity-75 text-decoration-none">Brands We Represent</a></li>
                                <li class="mb-2"><a href="/news" class="text-light opacity-75 text-decoration-none">Corporate News</a></li>
                                <li class="mb-2"><a href="/contactus" class="text-light opacity-75 text-decoration-none">Vendor Inquiries</a></li>
                            </ul>
                        </div>

                        <!-- Col 4: Sourcing & Central RFQ -->
                        <div class="col-md-6 col-lg-3">
                            <h5 class="text-uppercase fw-bold text-danger small tracking-wider mb-3">Technical Sourcing</h5>
                            <p class="text-light opacity-75 small mb-3">
                                For high-volume contracts, hard-to-find components, or distributor onboarding, contact our centralized desk.
                            </p>
                            <a t-att-href="'/request-quote' if (website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active))) else '/quote'" class="btn btn-danger btn-sm text-uppercase fw-bold w-100 mb-2">
                                <i class="fa fa-file-text-o me-1"/> Request a Quote
                            </a>
                            <a href="/contactus" class="btn btn-outline-light btn-sm text-uppercase fw-bold w-100">
                                <i class="fa fa-envelope-o me-1"/> Contact Management
                            </a>
                        </div>
                    </div>

                    <div class="o_liber_footer_bottom d-flex flex-wrap justify-content-between align-items-center pt-4 mt-4 border-top border-secondary small text-muted">
                        <span>© Liber Holdings Group. All rights reserved. <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Liber Industrial LLC · Bulverde, Texas.</t><t t-else="">Industrial supply heritage since 1946.</t></span>
                        <span>www.liberholdings.com</span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Suppress duplicate stock copyright footer -->
    <template id="footer_hide_stock_copyright" inherit_id="website.layout" name="Liber Hide Stock Copyright" priority="50">
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="before">
            <t t-set="no_copyright" t-value="True"/>
        </xpath>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="liber_homepage" name="Liber Holdings Homepage">
        <t t-call="website.layout">
            <t t-call="liber_holdings_theme.liber_homepage_body"/>
        </t>
    </template>

    <template id="liber_homepage_body" name="Liber Homepage Body">
        <div id="wrap" class="o_liber_homepage">
            <!-- Hero Banner: High-contrast typography and unified CTA buttons -->
            <section class="o_liber_hero position-relative" style="background: linear-gradient(135deg, #141618 0%, #22262B 100%);">
                <div class="container py-4 py-lg-5 position-relative" style="z-index: 5;">
                    <div class="row align-items-center">
                        <div class="col-lg-9 col-xl-8">
                            <span class="badge o_liber_hero_badge mb-3 px-3 py-2 text-uppercase letter-spacing-1">
                                <i class="fa fa-flag me-1"/> <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Est. 2018 • SDVOSB · Service-Disabled Veteran-Owned Small Business</t><t t-else="">Est. 2016 • Veteran-Owned Enterprise</t>
                            </span>
                            <h1 class="o_liber_hero_title mb-3">
                                <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Liber Industrial company overview</t><t t-else="">Industrial Distribution &amp; Precision Component Sourcing</t>
                            </h1>
                            <p class="o_liber_hero_desc mb-4">
                                <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">Liber Industrial is the industrial MRO supply and specialty chemical distribution company of the Liber Holdings group, based in Bulverde, Texas - vendor-managed inventory, plant storeroom optimization, strategic sourcing, DOD-related MRO parts and brewing chemicals for regional breweries.</t><t t-else="">Liber Holdings is the parent operating company uniting specialized industrial distributors and precision tooling suppliers across North America - operating heritage since 1946, supporting aerospace, automotive stamping, production plants and heavy industry.</t>
                            </p>
                            <div class="d-flex flex-wrap gap-3 align-items-center o_liber_hero_btn_group">
                                <a href="#companies" class="btn o_liber_btn_primary" style="background: #fff; color: #16181b; border: 1px solid #fff; opacity: 1; position: relative; z-index: 4; padding: .72rem 1.5rem; font-weight: 700; border-radius: 6px; text-decoration: none;">
                                    Our Companies <i class="fa fa-chevron-down ms-1"/>
                                </a>
                                <a href="/brands" class="btn o_liber_btn_outline" style="background: rgba(255,255,255,.10); color: #fff; border: 1px solid rgba(255,255,255,.6); opacity: 1; position: relative; z-index: 4; padding: .72rem 1.5rem; font-weight: 700; border-radius: 6px; text-decoration: none;">
                                    Brands We Represent
                                </a>
                                <a t-att-href="'/request-quote' if (website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active))) else '/quote'" class="btn o_liber_btn_accent" style="background: linear-gradient(135deg,#b8322a 0%,#d8453b 100%); color: #fff; border: 0; opacity: 1; position: relative; z-index: 4; padding: .72rem 1.5rem; font-weight: 700; border-radius: 6px; text-decoration: none;">
                                    Request a Quote <i class="fa fa-arrow-right ms-1"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Corporate Metrics / Trust Bar -->
            <section class="o_liber_metrics_bar py-4 border-bottom bg-white shadow-sm">
                <div class="container">
                    <div class="row g-3 text-center align-items-center">
                        <div class="col-6 col-md-3 border-end">
                            <div class="o_liber_metric_num"><t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">2018</t><t t-else="">2016</t></div>
                            <div class="o_liber_metric_title">Established</div>
                            <div class="o_liber_metric_sub"><t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))">SDVOSB · CVE Certified</t><t t-else="">Heritage Since 1946</t></div>
                        </div>
                        <div class="col-6 col-md-3 border-end">
                            <div class="o_liber_metric_num">100%</div>
                            <div class="o_liber_metric_title">Veteran-Owned</div>
                            <div class="o_liber_metric_sub">CVE-certified SDVOSB · Liber Holdings LLC</div>
                        </div>
                        <div class="col-6 col-md-3 border-end">
                            <div class="o_liber_metric_num">4 Hubs</div>
                            <div class="o_liber_metric_title">Regional Locations</div>
                            <div class="o_liber_metric_sub">Texas &amp; Pennsylvania</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="o_liber_metric_num">25,000+</div>
                            <div class="o_liber_metric_title">MRO &amp; Tooling SKUs</div>
                            <div class="o_liber_metric_sub">Comprehensive Catalog</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Family of Companies Section (Dale's core requirement) -->
            <section id="companies" class="py-5 bg-light">
                <div class="container py-4">
                    <div class="text-center mb-5">
                        <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Corporate Subsidiaries</span>
                        <h2 class="display-5 fw-bold mb-2">Our Family of Operating Companies</h2>
                        <p class="text-muted lead mx-auto" style="max-width: 650px;">
                            Each subsidiary provides specialized technical depth, dedicated inventory, and regional customer service.
                        </p>
                    </div>

                    <div class="row g-4">
                        <!-- RBC Industrial -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white p-3">
                                <div class="p-3 bg-light rounded-2 mb-3 text-center border">
                                    <h4 class="fw-bold mb-0"><a t-attf-href="https://www.rbc-industrial.com" target="_blank" rel="noopener" class="text-dark text-decoration-none o_liber_co_link">RBC Industrial</a></h4>
                                    <small class="text-danger fw-bold text-uppercase">RBC Industrial • El Paso, TX</small>
                                </div>
                                <div class="card-body p-0 d-flex flex-column">
                                    <h6 class="fw-bold mb-2">Bearings, Power Transmission &amp; MRO</h6>
                                    <p class="text-muted small mb-3 flex-grow-1">
                                        Established 1946. Premier industrial distributor of precision roller bearings, mechanical power transmission, industrial electrical, and MRO supplies serving Southwest plants and production facilities.
                                    </p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li><i class="fa fa-check text-success me-1"/> Timken, SKF, Sealmaster, Browning</li>
                                        <li><i class="fa fa-check text-success me-1"/> Strategic warehouse in El Paso, TX</li>
                                        <li><i class="fa fa-check text-success me-1"/> Full bilingual industrial support</li>
                                    </ul>
                                    <a t-attf-href="https://www.rbc-industrial.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm w-100 fw-bold o_liber_co_btn">Visit RBC Industrial <i class="fa fa-external-link ms-1"/></a>
                                </div>
                            </div>
                        </div>

                        <!-- Tooling Components -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white p-3">
                                <div class="p-3 bg-light rounded-2 mb-3 text-center border">
                                    <h4 class="fw-bold mb-0"><a t-attf-href="https://www.toolingcomponent.com" target="_blank" rel="noopener" class="text-dark text-decoration-none o_liber_co_link">Tooling Components</a></h4>
                                    <small class="text-danger fw-bold text-uppercase">Precision Tooling • Union City, PA</small>
                                </div>
                                <div class="card-body p-0 d-flex flex-column">
                                    <h6 class="fw-bold mb-2">Die Springs &amp; Press Tooling</h6>
                                    <p class="text-muted small mb-3 flex-grow-1">
                                        Industry authority for mechanical die springs, stamping die components, precision guide posts, and heavy forming hardware for tool and die makers nationwide.
                                    </p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li><i class="fa fa-check text-success me-1"/> Raymond, Danly, Bordeon springs</li>
                                        <li><i class="fa fa-check text-success me-1"/> Specialized engineering specs &amp; loads</li>
                                        <li><i class="fa fa-check text-success me-1"/> Rapid nationwide dispatch from PA</li>
                                    </ul>
                                    <a t-attf-href="https://www.toolingcomponent.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm w-100 fw-bold o_liber_co_btn">Visit Tooling Components <i class="fa fa-external-link ms-1"/></a>
                                </div>
                            </div>
                        </div>

                        <!-- Globe Electric Supply -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white p-3">
                                <div class="p-3 bg-light rounded-2 mb-3 text-center border">
                                    <h4 class="fw-bold text-dark mb-0">Globe Electric</h4>
                                    <small class="text-danger fw-bold text-uppercase">Electrical Supply • Texas</small>
                                </div>
                                <div class="card-body p-0 d-flex flex-column">
                                    <h6 class="fw-bold mb-2">Commercial &amp; Industrial Electrical</h6>
                                    <p class="text-muted small mb-3 flex-grow-1">
                                        Distributor of commercial and industrial electrical distribution equipment, motor controls, automation switches, wiring supplies, and plant infrastructure hardware.
                                    </p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li><i class="fa fa-check text-success me-1"/> Industrial motor controls &amp; panels</li>
                                        <li><i class="fa fa-check text-success me-1"/> Heavy-duty electrical safety gear</li>
                                        <li><i class="fa fa-check text-success me-1"/> Integrated commercial contracts</li>
                                    </ul>
                                    <a t-attf-href="https://www.globeelectricsupply.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm w-100 fw-bold o_liber_co_btn">Visit Globe Electric <i class="fa fa-external-link ms-1"/></a>
                                </div>
                            </div>
                        </div>

                        <!-- Liber Industrial -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white p-3">
                                <div class="p-3 bg-light rounded-2 mb-3 text-center border">
                                    <h4 class="fw-bold mb-0"><a t-attf-href="https://www.liberindustrial.com" target="_blank" rel="noopener" class="text-dark text-decoration-none o_liber_co_link">Liber Industrial</a></h4>
                                    <small class="text-danger fw-bold text-uppercase">MRO Solutions • Bulverde, TX</small>
                                </div>
                                <div class="card-body p-0 d-flex flex-column">
                                    <h6 class="fw-bold mb-2">Integrated MRO Contracts &amp; Supply</h6>
                                    <p class="text-muted small mb-3 flex-grow-1">
                                        Vendor-managed inventory (VMI), specialized supply contracts, and plant storeroom optimization for high-throughput fabrication and assembly operations.
                                    </p>
                                    <ul class="list-unstyled small text-muted mb-3">
                                        <li><i class="fa fa-check text-success me-1"/> Vendor managed inventory (VMI)</li>
                                        <li><i class="fa fa-check text-success me-1"/> Plant replenishment automation</li>
                                        <li><i class="fa fa-check text-success me-1"/> Strategic sourcing &amp; purchasing</li>
                                    </ul>
                                    <a t-attf-href="https://www.liberindustrial.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm w-100 fw-bold o_liber_co_btn">Visit Liber Industrial <i class="fa fa-external-link ms-1"/></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Brands We Represent Section -->
            <section class="py-5 bg-white">
                <div class="container py-4">
                    <div class="row align-items-center mb-4">
                        <div class="col-md-8">
                            <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Authorized Lines</span>
                            <h2 class="display-6 fw-bold mb-0">Premier Industrial Brands We Stock &amp; Represent</h2>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="/brands" class="btn btn-outline-danger fw-bold">View Full Brand Portfolio <i class="fa fa-arrow-right ms-1"/></a>
                        </div>
                    </div>

                    <div class="row g-3 text-center">
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">Raymond</strong>
                                <small class="text-muted">Die Springs</small>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">Danly</strong>
                                <small class="text-muted">Press Tooling</small>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">Bordeon</strong>
                                <small class="text-muted">Industrial Springs</small>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">Timken</strong>
                                <small class="text-muted">Precision Bearings</small>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">SKF</strong>
                                <small class="text-muted">Bearings &amp; Seals</small>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4 col-md-2">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-center">
                                <strong class="fs-5 text-dark">Browning</strong>
                                <small class="text-muted">Belts &amp; Sheaves</small>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Vendor Credibility & Partnership Hub (Dale's exact requirement: Vendor validation) -->
            <section class="py-5 bg-light border-top border-bottom">
                <div class="container py-4">
                    <div class="row g-5 align-items-center">
                        <div class="col-lg-6">
                            <span class="badge bg-secondary mb-2 px-3 py-2 text-uppercase">Vendor &amp; Supplier Relations</span>
                            <h2 class="display-6 fw-bold mb-3">Partnering with Liber Holdings</h2>
                            <p class="text-muted lead mb-4">
                                As a premier parent holding enterprise, Liber Holdings maintains an exemplary financial profile, verified commercial trade credit references, and active supplier partnerships.
                            </p>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="p-3 bg-white rounded border">
                                        <h6 class="fw-bold text-danger mb-1"><i class="fa fa-bank me-2"/>Financial Stability</h6>
                                        <p class="small text-muted mb-0">Decades of punctual supplier settlements and active credit insurance.</p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-white rounded border">
                                        <h6 class="fw-bold text-danger mb-1"><i class="fa fa-truck me-2"/>Distribution Network</h6>
                                        <p class="small text-muted mb-0">Cross-docking and warehouse facilities across Texas and Pennsylvania.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
                                <h3 class="h4 fw-bold mb-2">Vendor Validation &amp; Credit Verification</h3>
                                <p class="text-muted small mb-4">
                                    If you are a prospective supplier, distributor, or credit officer conducting trade verification for Liber Holdings or our subsidiaries, please contact our corporate administration.</p><p class="small text-muted mb-4 o_liber_cert_line"><b>Veteran-Owned · Service-Disabled Veteran-Owned (CVE Certified) · TX HUB · SAM Registered</b><br/>Liber Holdings LLC · UEI UAM8RE2L11U8 · CAGE 24H34 · verify in SBA VetCert
                                </p>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle me-3">
                                        <i class="fa fa-phone fa-lg"/>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase d-block">Corporate Phone</small>
                                        <a href="tel:+18327912535" class="fw-bold text-dark fs-5">+1 (832) 791-2535</a>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center mb-4">
                                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle me-3">
                                        <i class="fa fa-envelope fa-lg"/>
                                    </div>
                                    <div>
                                        <small class="text-muted text-uppercase d-block">Corporate Administration</small>
                                        <t t-if="website and (website.id == 7 or 'liberindustrial' in (website.domain or ''))"><a href="mailto:sales@liberindustrial.com" class="fw-bold text-dark fs-6">sales@liberindustrial.com</a></t><t t-else=""><a href="mailto:AP@liberholding.com" class="fw-bold text-dark fs-6">AP@liberholding.com</a></t>
                                    </div>
                                </div>
                                <a href="/contactus" class="btn btn-primary btn-lg text-uppercase fw-bold">
                                    Contact Corporate Office <i class="fa fa-arrow-right ms-2"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Ordering through the operating companies (replaces the catalog band: Liber Holdings is view-only,
                 Dale 9 Oct 2026, so it sends buyers to the subsidiaries instead of listing products) -->
            <section class="py-5 bg-white">
                <div class="container py-4 text-center">
                    <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase">Parts &amp; Ordering</span>
                    <h2 class="display-6 fw-bold mb-3">Order Through Our Operating Companies</h2>
                    <p class="text-muted lead mx-auto mb-4" style="max-width: 680px;">
                        Liber Holdings does not sell directly. Bearings, power transmission and MRO supply are handled by RBC Industrial;
                        die and mold components by Tooling Components.
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="https://www.rbc-industrial.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-lg px-4 fw-bold">
                            RBC Industrial <i class="fa fa-external-link ms-2"/>
                        </a>
                        <a href="https://www.toolingcomponent.com" target="_blank" rel="noopener" class="btn btn-outline-dark btn-lg px-4 fw-bold">
                            Tooling Components <i class="fa fa-external-link ms-2"/>
                        </a>
                        <a href="/contactus" class="btn btn-danger btn-lg px-4 fw-bold">
                            <i class="fa fa-envelope-o me-2"/> Contact Liber Holdings
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </template>

    <template id="homepage_liber" inherit_id="website.homepage" name="Liber Homepage Override" priority="99">
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-if="(website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active))) or (request and request.website and not (('x_rbc_theme_active' in request.website and request.website.x_rbc_theme_active) or ('x_tc_theme_active' in request.website and request.website.x_tc_theme_active) or ('x_tooling_theme_active' in request.website and request.website.x_tooling_theme_active)))">
                <t t-call="liber_holdings_theme.liber_homepage_body"/>
            </t>
            <t t-else="">
                <div id="wrap" class="oe_structure oe_empty"/>
            </t>
        </xpath>
    </template>

</odoo>

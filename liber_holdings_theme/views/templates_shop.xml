<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_sale.products_description" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

    <!-- Keep stock icon add-to-cart OFF; Liber uses RFQ text CTAs -->
    <record id="website_sale.products_add_to_cart" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Shop + category meta description, title, and h1 -->
    <template id="products_shop_meta" inherit_id="website_sale.products" name="Liber Shop Meta" priority="40">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title" t-value="category.name if category else (('Search: %s' % search) if search else 'Industrial Sourcing &amp; Parts Catalog')"/>
            <t t-set="website_meta_description" t-value="('%s from %s: View technical specifications and request quotes.' % (category.name, website.name)) if category else ('Industrial spare parts and tooling catalog from %s: Request volume pricing and quotes.' % website.name)"/>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <t t-set="liber_site_h1" t-value="'liber' in (website.name or '').lower()"/>
            <div t-if="False and liber_site_h1" class="pb-3 border-bottom mb-4">
                <span class="badge bg-danger mb-1 text-uppercase">Technical Reference Catalog</span>
                <h1 class="h2 mb-1 mt-1 fw-bold"><t t-if="category" t-out="category.name"/><t t-elif="search">Search results for "<t t-esc="search"/>"</t><t t-else="">Industrial Parts &amp; Tooling Catalog</t></h1>
                <p class="text-muted small mb-0">Browse specifications and submit for quote or expedited replenishment across our family of companies.</p>
            </div>
        </xpath>
    </template>

    <!-- Rebuild Product Card in Grid & List View: Clean styling with SKU, Specs & Request Quote CTA -->
    <template id="products_item_liber" inherit_id="website_sale.products_item" name="Liber Product Card" priority="50">
        <xpath expr="//form[hasclass('oe_product_cart')]" position="attributes">
            <attribute name="class">oe_product_cart o_liber_product_card h-100 d-flex flex-column border rounded-2 shadow-sm bg-white overflow-hidden</attribute>
            <attribute name="style">position: relative;</attribute>
        </xpath>

        <xpath expr="//div[hasclass('oe_product_image')]" position="attributes">
            <attribute name="class">oe_product_image o_liber_product_image position-relative flex-grow-0 overflow-hidden text-center p-3</attribute>
        </xpath>

        <xpath expr="//form[hasclass('oe_product_cart')]" position="inside">
            <a t-att-href="product.website_url" class="o_liber_card_overlay"
               t-att-aria-label="product.name" tabindex="-1"
               style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; text-indent: -9999px; overflow: hidden;"/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="replace">
            <t t-set="is_liber" t-value="'liber' in (website.name or '').lower()"/>
            <div class="o_liber_card_footer mt-auto p-3 border-top bg-light d-flex flex-column gap-2">
                <div class="d-flex align-items-center" style="gap: 0.75rem; flex-wrap: nowrap; min-width: 0;">
                    <span t-if="product.default_code" class="badge bg-secondary text-uppercase small font-monospace"
                          style="max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 0 1 auto;">
                        SKU: <t t-esc="product.default_code"/>
                    </span>
                    <span t-if="is_liber" class="text-danger small fw-bold"
                          style="margin-left: auto; white-space: nowrap; flex: 0 0 auto;">
                        <i class="fa fa-phone me-1"/> Direct Quote
                    </span>
                </div>
                <!-- Top 4 Product Specifications (Dale's requirement for technical list view) -->
                <t t-set="specs" t-value="product.attribute_line_ids[:4]"/>
                <div t-if="specs" class="small text-muted py-1">
                    <t t-foreach="specs" t-as="sp">
                        <span class="badge bg-white text-dark border me-1 mb-1" style="font-size: 0.72rem;">
                            <t t-esc="sp.attribute_id.name"/>: <t t-esc="', '.join(sp.value_ids.mapped('name'))"/>
                        </span>
                    </t>
                </div>
                <div class="o_liber_card_actions mt-1" style="position: relative; z-index: 3;">
                    <a t-att-href="('/request-quote' if (website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active))) else '/quote') + '?product_id=%s' % product.id"
                       class="btn btn-primary btn-sm w-100 fw-bold text-uppercase">
                        Request Quote
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <template id="products_categories_liber" inherit_id="website_sale.products_categories_list" name="Liber Categories Title" priority="50">
        <xpath expr="//h6" position="replace">
            <h6 class="mb-2 fw-bold text-uppercase text-danger" style="font-size: 0.85rem; letter-spacing: 0.05em;">Categories</h6>
        </xpath>
    </template>

    <!-- Category filmstrip: icon-over-label tiles instead of cramped horizontal pills -->
    <template id="filmstrip_categories_liber"
              inherit_id="website_sale.filmstrip_categories"
              name="Liber Category Filmstrip"
              priority="50">
        <xpath expr="//div[hasclass('o_wsale_filmstip_container')]" position="attributes">
            <attribute name="class" add="o_liber_filmstrip" separator=" "/>
        </xpath>
        <xpath expr="//ul[hasclass('o_wsale_filmstip')]" position="replace">
            <ul class="o_wsale_filmstip o_liber_filmstrip_list d-flex align-items-stretch mb-0 list-unstyled overflow-visible">
                <t t-foreach="entries" t-as="c" t-if="c.image_128" t-set="atLeastOneImage" t-value="True"/>
                <li t-foreach="entries" t-as="c"
                    t-attf-class="o_liber_film_item {{'is-active' if category and c.id == category.id else ''}}"
                    t-att-data-link-href="keep('/shop/category/' + slug(c), category=0)">
                    <div class="o_liber_cat_chip"
                         t-att-aria-current="category and c.id == category.id and 'page' or None">
                        <span t-if="c.image_128"
                              class="o_liber_cat_chip_media"
                              t-attf-style="background-image:url('data:image/png;base64,#{c.image_128}')"
                              t-att-aria-label="c.name"/>
                        <span t-else="" class="o_liber_cat_chip_media o_liber_cat_chip_placeholder"
                              t-esc="(c.name or '?')[:1]"/>
                        <span class="o_liber_cat_chip_label" t-field="c.name"/>
                    </div>
                </li>
            </ul>
        </xpath>
    </template>

</odoo>

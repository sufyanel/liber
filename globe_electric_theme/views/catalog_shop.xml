<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="gcat_catalog_action" name="Globe catalog action buttons">
        <div class="gcat-actions">
            <a t-att-href="product.website_url" class="gcat-btn-cart" title="View details">View</a>
            <a t-att-href="'/quote?product_id=%s' % product.id" class="gcat-btn-rfq" title="Request a quote">Request Quote</a>
        </div>
    </template>

    <template id="gcat_shop" inherit_id="website_sale.products" name="Globe Electric: product catalog" priority="61">
        <xpath expr="//t[@t-set='additional_title']" position="after">
            <t t-if="('x_globe_theme_active' in website and website.x_globe_theme_active)">
                <t t-if="category" t-set="additional_title" t-value="category.name"/>
                <t t-else="" t-set="additional_title">Product Catalog</t>
                <t t-set="meta_description">Browse Globe Electric Supply's catalog of lighting, rail, traffic, aviation and electrical distribution products - request a quote on any part.</t>
            </t>
        </xpath>

        <!-- Page title + intro above Odoo's search / sort / layout toolbar -->
        <xpath expr="//div[@id='products_grid']//div[hasclass('products_header')]" position="before">
            <div t-if="('x_globe_theme_active' in website and website.x_globe_theme_active)" class="gcat-catalog-head">
                <h1><t t-if="category" t-out="category.name"/><t t-else="">Product Catalog</t></h1>
                <p>Browse by product line or filter by specification. This catalog is view-only: request a quote on any part and we confirm price, availability and lead time.</p>
            </div>
        </xpath>

        <xpath expr="//div[@id='products_grid']" position="inside">
            <div t-if="('x_globe_theme_active' in website and website.x_globe_theme_active)" class="gcat-cta-band gcat-cta-band-sm">
                <div><h2>Don't See Your Part Number?</h2><p>Send the part number, the specification or the bill of materials - we source to spec, including obsolete and hard-to-find parts.</p></div>
                <a href="/quote" class="globe-btn globe-btn-accent">Request a Quote</a>
            </div>
        </xpath>


        <!-- Result bar: count + active filter chips (each chip removes its filter) -->
        

        <!-- Compact filter card (replaces Odoo's long filter rail on Globe only) -->
        <xpath expr="//aside[@id='products_grid_before'][not(hasclass('rbc-filter-aside'))][not(hasclass('tc-filter-aside'))]" position="replace">
            <t t-if="('x_globe_theme_active' in website and website.x_globe_theme_active)">
                <aside t-if="hasLeftColumn" id="products_grid_before" class="d-none d-lg-block col-3 gcat-filter-aside">
                    <div class="gcat-filter-card">
                        <div class="gcat-filter-title">
                            <span>Filter Products</span>
                            <a t-if="attrib_set or category" href="/shop" class="gcat-filter-clear">Clear all</a>
                        </div>
                        <div class="gcat-filter-group">
                            <div class="gcat-filter-label">Category</div>
                            <ul class="gcat-cat-list">
                                <li><a href="/shop" t-attf-class="#{'active' if not category else ''}">All Products</a></li>
                                <t t-foreach="request.env['product.public.category'].search([('parent_id', '=', False)] + request.website.website_domain())" t-as="c">
                                    <li>
                                        <a t-attf-href="/shop/category/#{slug(c)}" t-attf-class="#{'active' if category and category.id == c.id else ''}" t-out="c.name"/>
                                        <ul t-if="c.child_id and category and (category.id == c.id or category.parent_id.id == c.id)" class="gcat-cat-sub">
                                            <li t-foreach="c.child_id" t-as="cc">
                                                <a t-attf-href="/shop/category/#{slug(cc)}" t-attf-class="#{'active' if category.id == cc.id else ''}" t-out="cc.name"/>
                                            </li>
                                        </ul>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        <form t-if="attributes" class="js_attributes gcat-attr-form" method="get">
                            <input t-if="category" type="hidden" name="category" t-att-value="category.id"/>
                            <input type="hidden" name="search" t-att-value="search"/>
                            <input type="hidden" name="order" t-att-value="order"/>
                            <t t-set="used_vals" t-value="set(search_product.attribute_line_ids.value_ids.ids) if search_product else False"/>
                            <t t-foreach="attributes" t-as="a">
                                <t t-set="a_vals" t-value="[v for v in a.value_ids if (used_vals is False) or (v.id in used_vals) or (v.id in attrib_set)]"/>
                                <t t-set="a_selected" t-value="any(v.id in attrib_set for v in a.value_ids)"/>
                                <details t-if="a_vals" class="gcat-filter-group" t-att-open="'open' if a_selected else None">
                                    <summary class="gcat-filter-label">
                                        <t t-out="a.name"/>
                                        <span t-if="a_selected" class="gcat-filter-count" t-out="len([v for v in a.value_ids if v.id in attrib_set])"/>
                                    </summary>
                                    <input t-if="len(a_vals) &gt; 6" type="search" class="gcat-value-search" t-att-placeholder="'Search %s…' % a.name.lower()" aria-label="Search values"/>
                                    <div class="gcat-attr-values">
                                        <label t-foreach="a_vals" t-as="v" class="gcat-check">
                                            <input type="checkbox" name="attrib" t-att-value="'%s-%s' % (a.id, v.id)"
                                                   t-att-checked="'checked' if v.id in attrib_set else None"/>
                                            <span t-out="v.name"/>
                                        </label>
                                    </div>
                                </details>
                            </t>
                        </form>
                    </div>
                </aside>
            </t>
            <t t-else="">$0</t>
        </xpath>


        <!-- Active filter chips (click x to remove one filter) -->
        <xpath expr="//div[@id='products_grid']//div[hasclass('products_header')]" position="after">
            <t t-if="('x_globe_theme_active' in website and website.x_globe_theme_active) and attrib_set">
                <t t-set="tc_sel" t-value="request.env['product.attribute.value'].browse(list(attrib_set)).exists()"/>
                <div class="gcat-chips">
                    <span class="gcat-chips-label">Active filters:</span>
                    <t t-foreach="tc_sel" t-as="sv">
                        <a class="gcat-fchip" t-att-href="keep(attrib=['%s-%s' % (o.attribute_id.id, o.id) for o in tc_sel if o.id != sv.id])">
                            <span class="k" t-out="sv.attribute_id.name"/>: <t t-out="sv.name"/> <i class="fa fa-times"/>
                        </a>
                    </t>
                    <a class="gcat-fchip-clear" t-att-href="keep(attrib=[])">Clear all</a>
                </div>
            </t>
        </xpath>

        <!-- Catalog: dense table (list layout) + compact cards (grid layout) -->
        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="inside">
            <t t-if="('x_globe_theme_active' in website and website.x_globe_theme_active)">
                <div class="gcat-catalog">
                    <div class="gcat-qf-status" aria-live="polite"/>
                    <div class="gcat-table-wrap">
                        <table class="gcat-table">
                            <thead>
                                <tr>
                                    <th class="c-part">Part No</th>
                                    <th class="c-cat">Category</th>
                                    <th class="c-spec">Specs</th>
                                    <th class="c-desc">Description</th>
                                    
                                    
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="products" t-as="product">
                                    <t t-set="p_lines" t-value="product.attribute_line_ids.filtered(lambda l: l.value_ids).sorted(lambda l: (l.attribute_id.sequence, l.attribute_id.id))"/><t t-set="p_qty" t-value="product.sudo().qty_available if product.type == 'product' else 99"/><t t-set="stock" t-value="('in', 'EN EXISTENCIA' if ((request.env.lang or '')[:2] == 'es') else 'IN STOCK') if p_qty &gt; 10 else (('low', 'POCAS PIEZAS' if ((request.env.lang or '')[:2] == 'es') else 'LOW') if p_qty &gt; 0 else ('lead', 'SOBRE PEDIDO' if ((request.env.lang or '')[:2] == 'es') else 'LEAD TIME'))"/><t t-set="quote" t-value="('Request Quote' in product.product_tag_ids.with_context(lang='en_US').mapped('name')) or (not product._is_add_to_cart_possible()) or (not product.list_price)"/><t t-set="p_cat" t-value="product.public_categ_ids[:1].name or ''"/><t t-set="p_spec" t-value="' · '.join([', '.join(l.value_ids.mapped('name')) for l in p_lines[:4]])"/>
                                    <td class="c-part"><a t-att-href="product.website_url" class="gcat-pname" t-out="product.name"/></td>
                                    <td class="c-cat"><span t-if="p_cat" class="gcat-chip" t-out="p_cat"/></td>
                                    <td class="c-spec gcat-spec" t-out="p_spec"/>
                                    <td class="c-desc gcat-desc" t-out="product.description_sale or ''"/>
                                    <td class="text-center"><t t-call="globe_electric_theme.gcat_catalog_action"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="gcat-cards">
                        <div t-foreach="products" t-as="product" class="gcat-pcard">
                            <t t-set="p_lines" t-value="product.attribute_line_ids.filtered(lambda l: l.value_ids).sorted(lambda l: (l.attribute_id.sequence, l.attribute_id.id))"/><t t-set="p_qty" t-value="product.sudo().qty_available if product.type == 'product' else 99"/><t t-set="stock" t-value="('in', 'EN EXISTENCIA' if ((request.env.lang or '')[:2] == 'es') else 'IN STOCK') if p_qty &gt; 10 else (('low', 'POCAS PIEZAS' if ((request.env.lang or '')[:2] == 'es') else 'LOW') if p_qty &gt; 0 else ('lead', 'SOBRE PEDIDO' if ((request.env.lang or '')[:2] == 'es') else 'LEAD TIME'))"/><t t-set="quote" t-value="('Request Quote' in product.product_tag_ids.with_context(lang='en_US').mapped('name')) or (not product._is_add_to_cart_possible()) or (not product.list_price)"/><t t-set="p_cat" t-value="product.public_categ_ids[:1].name or ''"/><t t-set="p_spec" t-value="' · '.join([', '.join(l.value_ids.mapped('name')) for l in p_lines[:4]])"/>
                            <a t-att-href="product.website_url" class="gcat-pcard-img">
                                <img t-if="product.image_128" t-att-src="'/web/image/product.template/%s/image_256' % product.id" t-att-alt="product.name" loading="lazy" decoding="async" width="400" height="400"/>
                                <span t-else="" t-out="product.name"/>
                            </a>
                            <div class="gcat-pcard-body">
                                <div class="d-flex justify-content-between align-items-center gap-1">
                                    <span t-if="p_cat" class="gcat-chip" t-out="p_cat"/>
                                </div>
                                <a t-att-href="product.website_url" class="gcat-part" t-out="product.name"/>
                                <div class="gcat-desc" t-out="product.description_sale or ''"/>
                                <div class="gcat-spec" t-out="p_spec"/>
                                <div class="gcat-pcard-foot">
                                    <t t-call="globe_electric_theme.gcat_catalog_action"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Not scheduled to run on its own (active=False): open this record
            under Settings > Technical > Scheduled Actions and use "Run
            Manually" once you're ready to apply the fix in production.
            See models/product_template.py for what it does and
            POLLUTED_PRODUCT_REFS for the list of products it covers.

            This module is a one-time data fix: once you've confirmed the
            products in POLLUTED_PRODUCT_REFS are clean, it can be
            uninstalled - it adds no fields and owns no other data.
        -->
        <record id="ir_cron_fix_polluted_variant_combinations" model="ir.cron">
            <field name="name">Fix Polluted Variant Combinations</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_fix_polluted_variant_combinations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>

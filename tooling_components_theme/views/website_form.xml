<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website > Configuration > Websites > Tooling Components -->
    <record id="view_website_form_tc" model="ir.ui.view">
        <field name="name">website.form.tc.industrial</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Tooling Components Theme" name="tc_theme">
                    <field name="x_tc_theme_active"/>
                    <field name="x_tc_logo" widget="image" class="oe_avatar" invisible="not x_tc_theme_active"/>
                    <field name="x_tc_quote_form_url" widget="url" invisible="not x_tc_theme_active"
                           placeholder="https://api.leadconnectorhq.com/widget/form/... (empty = Odoo quote form)"/>
                    <field name="x_tc_line_card_url" widget="url" invisible="not x_tc_theme_active"
                           placeholder="https://www.toolingcomponent.com/web/content/... (PDF)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

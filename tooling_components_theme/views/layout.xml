<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- html flag + fonts + LocalBusiness schema (TC website only) -->
    <template id="tc_layout_head" inherit_id="website.layout" name="Tooling Components: head" priority="62">
        <xpath expr="//html" position="attributes">
            <attribute name="t-att-data-tc-theme">'1' if (website and website.x_tc_theme_active) else None</attribute>
            <attribute name="t-att-data-tc-version">'17.0.8.1.0' if (website and website.x_tc_theme_active) else None</attribute>
        </xpath>
        <xpath expr="//head" position="inside">
            <t t-if="website and website.x_tc_theme_active">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <t t-if="website.x_tc_quote_form_url">
                    <link rel="preconnect" href="https://api.leadconnectorhq.com"/>
                    <link rel="preconnect" href="https://link.msgsndr.com"/>
                    <link rel="dns-prefetch" href="https://api.leadconnectorhq.com"/>
                </t>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap"/>
                <t t-if="request and request.is_frontend_multilang and website.is_public_user() and len(website.language_ids) &gt; 1 and not alternate_languages">
                    <meta name="tc-hreflang" content="fallback: request URL did not match canonical URL"/>
                    <t t-set="tc_shorts" t-value="[l.code.split('_')[0] for l in website.language_ids]"/>
                    <t t-foreach="website.language_ids" t-as="tc_lg">
                        <t t-set="tc_short" t-value="tc_lg.code.split('_')[0]"/>
                        <link rel="alternate" t-att-hreflang="tc_short if tc_shorts.count(tc_short) == 1 else tc_lg.code.replace('_', '-').lower()"
                              t-att-href="website._get_canonical_url_localized(lang=tc_lg, canonical_params=canonical_params)"/>
                    </t>
                    <link rel="alternate" hreflang="x-default" t-att-href="website._get_canonical_url_localized(lang=website.default_lang_id, canonical_params=canonical_params)"/>
                </t>
                <script type="application/ld+json">{"@context": "https://schema.org", "@type": "LocalBusiness", "name": "Tooling Components LLC", "description": "Veteran-owned supplier of precision mold and die components: ejector pins, leader pins and bushings, support pillars, die springs and mold components.", "url": "https://www.toolingcomponent.com", "telephone": "+1-814-438-7657", "email": "sales@toolingcomponent.com", "foundingDate": "1987", "address": {"@type": "PostalAddress", "streetAddress": "8349 West High St.", "addressLocality": "Union City", "addressRegion": "PA", "postalCode": "16438", "addressCountry": "US"}, "areaServed": ["United States", "Canada", "Mexico"]}</script>
            </t>
        </xpath>
    </template>

    <!-- Header: emergency bar + dark nav with logo, menu, badges, search, cart, account -->
    <template id="tc_layout_header" inherit_id="website.layout" name="Tooling Components: header" priority="62">
        <xpath expr="//header[@id='top'][not(contains(@class, 'o_rbc_header'))]" position="replace">
            <t t-if="website and website.x_tc_theme_active">
                <header t-if="not no_header" id="top" data-anchor="true" data-name="Header" class="o_tc_header o_no_autohide_menu">
                    <div class="tc-emergency-bar">
                        <span class="tc-pulse"/>
                        MOLD DOWN? SAME-DAY QUOTES &amp; SHIPPING ON 15,000+ IN-STOCK SKUs —
                        <a href="tel:+18144387657">CALL 814-438-7657</a>
                    </div>
                    <nav class="navbar navbar-expand-lg tc-navbar">
                        <div class="container">
                            <a href="/" class="navbar-brand tc-brand" aria-label="Tooling Components home">
                                <img t-if="website.x_tc_logo" t-att-src="image_data_uri(website.x_tc_logo)" alt="Tooling Components" class="tc-logo"/>
                                <img t-else="" src="/tooling_components_theme/static/src/img/tc_logo.png" alt="Tooling Components" class="tc-logo"/>
                            </a>
                            <button class="navbar-toggler tc-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#tcNav" aria-controls="tcNav" aria-expanded="false" aria-label="Toggle navigation">
                                <i class="fa fa-bars"/>
                            </button>
                            <div class="collapse navbar-collapse" id="tcNav">
                                <ul id="top_menu" class="navbar-nav ms-auto tc-menu" role="menu">
                                    <t t-set="tc_path" t-value="request.httprequest.path"/>
                                    <li class="nav-item" role="presentation">
                                        <a href="/" role="menuitem" t-attf-class="nav-link #{'active' if tc_path == '/' else ''}">Home</a>
                                    </li>
                                    <t t-foreach="website.menu_id.child_id" t-as="menu">
                                        <li t-if="menu.is_visible" class="nav-item" role="presentation">
                                            <a t-att-href="menu.url" role="menuitem"
                                               t-attf-class="nav-link #{'active' if (menu.url and '#' not in menu.url and menu.url != '/' and tc_path.startswith(menu.url)) else ''}"
                                               t-out="menu.name"/>
                                        </li>
                                    </t>
                                </ul>
                                <div class="tc-cert-badges d-flex">
                                    <span class="tc-cert-badge">EST. 1987</span>
                                    <span class="tc-cert-badge">VETERAN-OWNED</span>
                                </div>
                                <a href="/quote" class="tc-btn-gold tc-btn-sm tc-header-cta d-none d-lg-inline-block">Request a Quote</a>
                                <ul class="navbar-nav tc-tools align-items-lg-center">
                                    <li t-if="website.x_tc_line_card_url" class="nav-item">
                                        <a t-att-href="website.x_tc_line_card_url" target="_blank" rel="noopener" class="nav-link tc-linecard" title="Download Line Card (PDF)">
                                            <i class="fa fa-download"/> <span class="d-lg-none d-xl-inline">Line Card</span>
                                        </a>
                                    </li>
                                    <li t-if="len(website.language_ids) &gt; 1" class="nav-item tc-lang">
                                        <t t-foreach="website.language_ids" t-as="lg">
                                            <a t-att-href="url_for(request.httprequest.path, lang_code=lg.url_code)"
                                               t-attf-class="js_change_lang tc-lang-link #{'active' if lg.code == request.env.lang else ''}" t-att-data-lang="lg.code"
                                               t-att-data-url_code="lg.url_code" t-att-title="lg.name" t-out="lg.iso_code[:2].upper()"/>
                                        </t>
                                    </li>
                                                                        <li class="nav-item">
                                        <a href="/shop/cart" class="nav-link tc-cart" title="Cart" aria-label="Cart">
                                            <i class="fa fa-shopping-cart"/>
                                            <span class="tc-cart-qty my_cart_quantity" t-out="request.session.get('website_sale_cart_quantity') or 0"/>
                                        </a>
                                    </li>
                                    <t t-call="portal.placeholder_user_sign_in">
                                        <t t-set="_link_class" t-valuef="nav-link"/>
                                    </t>
                                    <t t-call="portal.user_dropdown">
                                        <t t-set="_user_name" t-value="True"/>
                                        <t t-set="_item_class" t-valuef="nav-item dropdown"/>
                                        <t t-set="_link_class" t-valuef="nav-link"/>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </nav>
                </header>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- Footer -->
    <template id="tc_layout_footer" inherit_id="website.layout" name="Tooling Components: footer" priority="62">
        <xpath expr="//footer[@id='bottom'][not(contains(@class, 'rbc-footer'))]" position="replace">
            <t t-if="website and website.x_tc_theme_active">
                <footer t-if="not no_footer" id="bottom" data-anchor="true" data-name="Footer" class="tc-footer">
                    <div class="container">
                        <div class="tc-footer-grid">
                            <div>
                                <h4>Tooling Components LLC</h4>
                                <p>Precision components for molds and dies. Family-owned since 1987, veteran-owned since 2023 — engineered for zero-failure reliability in mission-critical manufacturing.</p>
                                <p>8349 West High St., Union City, PA 16438<br/>
                                    Phone: <a href="tel:+18144387657">814-438-7657</a><br/>
                                    <a href="mailto:sales@toolingcomponent.com">sales@toolingcomponent.com</a></p>
                                <div class="tc-cert-line">
                                    <span class="tc-cert-badge tc-cert-badge-dark">Established 1987</span>
                                    <span class="tc-cert-badge tc-cert-badge-dark">Family-Owned Since 1987 · Veteran-Owned Since 2023</span>
                                </div>
                            </div>
                            <div>
                                <h4>Solutions</h4>
                                <t t-set="tc_cats" t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False)], limit=4)"/>
                                <p t-foreach="tc_cats" t-as="cat"><a t-attf-href="/shop/category/#{slug(cat)}" t-out="cat.name"/></p>
                                <p><a href="/contactus">Request a Quote</a></p>
                            </div>
                            <div>
                                <h4>Resources</h4>
                                <p><a href="/blog">Technical Resources</a></p>
                                <p><a href="/about-us">About Tooling Components</a></p>
                                <p t-if="website.x_tc_line_card_url"><a t-att-href="website.x_tc_line_card_url" target="_blank" rel="noopener"><i class="fa fa-download"/> Download Line Card (PDF)</a></p>
                                <p><a href="/quote">Request Quote</a></p>
                            </div>
                        </div>
                        <div class="tc-copyright">© <t t-out="datetime.date.today().year"/> Tooling Components LLC. All rights reserved.</div>
                    </div>
                </footer>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

</odoo>

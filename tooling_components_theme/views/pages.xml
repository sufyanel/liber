<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reusable pieces ================================================== -->
    <template id="tc_breadcrumb" name="TC breadcrumb">
        <div class="container">
            <nav class="tc-breadcrumbs" aria-label="breadcrumb">
                <a href="/">Home</a><span class="sep">›</span><span class="current" t-out="crumb"/>
            </nav>
        </div>
    </template>

    <template id="tc_quote_form" name="TC quote form">
        <t t-if="website.x_tc_quote_form_url">
            <t t-set="ghl_id" t-value="website.x_tc_quote_form_url.rstrip('/').split('/')[-1]"/>
            <div class="tc-ghl-form tc-ghl-loading">
                <iframe t-att-src="website.x_tc_quote_form_url" t-att-id="'inline-' + ghl_id" t-att-data-form-id="ghl_id"
                        data-layout="{'id':'INLINE'}" data-trigger-type="alwaysShow" data-activation-type="alwaysActivated"
                        data-deactivation-type="neverDeactivate" data-form-name="TC Request a Quote" data-layout-iframe-id="'inline-' + ghl_id"
                        title="Request a Quote" loading="eager" importance="high" onload="this.parentElement.classList.remove('tc-ghl-loading')" style="width:100%;min-height:760px;border:none;border-radius:4px"/>
                <script defer="defer" src="https://link.msgsndr.com/js/form_embed.js"/>
            </div>
            <p class="tc-form-note">For immediate line-down emergencies, call <a href="tel:+18144387657">814-438-7657</a>.</p>
        </t>
        <t t-else="">
        <section class="s_website_form tc-rfq-form" data-vcss="001" data-snippet="s_website_form">
            <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required tc-form"
                  data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                <div class="s_website_form_rows row s_col_no_bgcolor">
                    <div class="s_website_form_field s_website_form_dnone" data-name="Field">
                        <input type="hidden" class="form-control s_website_form_input" name="name"
                               t-att-value="('RFQ: ' + product.name) if product else 'RFQ from TC website'"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2 s_website_form_required" data-type="char" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_name"><span class="s_website_form_label_content">Name</span><span class="s_website_form_mark"> *</span></label>
                        <input id="tc_f_name" type="text" class="form-control s_website_form_input" name="contact_name" required="1" placeholder="Your full name"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2" data-type="char" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_company"><span class="s_website_form_label_content">Company</span></label>
                        <input id="tc_f_company" type="text" class="form-control s_website_form_input" name="partner_name" placeholder="Company name"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2 s_website_form_required" data-type="email" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_email"><span class="s_website_form_label_content">Email</span><span class="s_website_form_mark"> *</span></label>
                        <input id="tc_f_email" type="email" class="form-control s_website_form_input" name="email_from" required="1" placeholder="you@company.com"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2" data-type="tel" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_phone"><span class="s_website_form_label_content">Phone</span></label>
                        <input id="tc_f_phone" type="tel" class="form-control s_website_form_input" name="phone" placeholder="(915) 555-0100"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2 s_website_form_custom" data-type="char" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_part"><span class="s_website_form_label_content">Part Number or Need</span></label>
                        <input id="tc_f_part" type="text" class="form-control s_website_form_input" name="Part Number or Need" placeholder="e.g. SKF 6205-2RS / or describe application" t-att-value="product and product.name or ''"/>
                    </div>
                    <div class="s_website_form_field col-md-6 mb-2 s_website_form_custom" data-type="selection" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_urgency"><span class="s_website_form_label_content">Urgency</span></label>
                        <select id="tc_f_urgency" class="form-select s_website_form_input" name="Urgency"><option value="Standard - same business day">Standard — same business day</option><option value="Expedited - 24 hours">Expedited — 24 hours</option><option value="EMERGENCY - line down">Emergency — line down</option></select>
                    </div>
                    <div class="s_website_form_field col-12 mb-2" data-type="text" data-name="Field">
                        <label class="s_website_form_label" for="tc_f_msg"><span class="s_website_form_label_content">Message</span></label>
                        <textarea id="tc_f_msg" class="form-control s_website_form_input" name="description" rows="4" placeholder="Application, quantities, required specs, cross-reference info…"/>
                    </div>
                    <div class="s_website_form_submit col-12 mt-1">
                        <a role="button" href="#" class="btn s_website_form_send tc-btn-gold">Submit Quote Request</a>
                        <span id="s_website_form_result"/>
                    </div>
                </div>
            </form>
            <p class="tc-form-note">Mold down right now? Call <a href="tel:+18144387657">814-438-7657</a> and press 2 instead of waiting on this form.</p>
        </section>
        </t>
    </template>

    <template id="tc_solution_cards" name="TC solution cards">
        <div class="tc-grid-3">
            <t t-foreach="[('Ejector Pins', 'Straight, shoulder and blade pins in H13, M2 and stainless — nitrided and centerless-ground for high-cycle molds.', '/shop', ['Ejector'], 'Botadores', 'Botadores rectos, escalonados y de cuchilla en H13, M2 e inoxidable, nitrurados y rectificados sin centros para moldes de alto ciclaje.'),
                   ('Leader Pins &amp; Bushings', 'Inch, DIN and JIS alignment sets toleranced for high-tonnage presses.', '/shop', ['Leader', 'Bushing'], 'Pernos guía y bujes', 'Juegos de alineación en pulgadas, DIN y JIS con tolerancias para prensas de alto tonelaje.'),
                   ('Support Pillars', 'Deflection-resistant pillars rated up to 500 kN each, in standard and custom heights.', '/shop', ['Pillar', 'Support'], 'Columnas de soporte', 'Columnas resistentes a la deflexión, para cargas de hasta 500 kN cada una, en alturas estándar y especiales.'),
                   ('Mold Components', 'Locating rings, interlocks, lifters and sidelocks to ISO, JIS and DIN standards.', '/shop', ['Mold', 'Locating'], 'Componentes de molde', 'Anillos centradores, seguros de alineación, levantadores y candados laterales bajo normas ISO, JIS y DIN.'),
                   ('Springs &amp; Accessories', 'Chrome-silicon die springs rated for millions of cycles, plus sidelocks and hardware.', '/shop', ['Spring'], 'Resortes y accesorios', 'Resortes para troquel de cromo-silicio para millones de ciclos, además de candados laterales y herrajes.'),
                   ('Punches, Die Sets &amp; Fasteners', 'Round and shaped punches in A2/D2, standard and custom die sets, SHCS and dowels.', '/shop', ['Punch', 'Die Set', 'Press Die', 'Fastener'], 'Punzones, portatroqueles y tornillería', 'Punzones redondos y de forma en A2/D2, portatroqueles estándar y especiales, tornillos allen y pernos guía.')]" t-as="sol">
                <t t-set="sol_cat" t-value="request.env['product.public.category'].sudo().search((['|'] * (len(sol[3]) - 1)) + [('name', 'ilike', k) for k in sol[3]], limit=1) if sol[3] else False"/>
                <t t-set="sol_url" t-value="sol[2] if not sol[3] else (('/shop/category/%s' % slug(sol_cat)) if sol_cat else ('/shop?search=%s' % sol[3][0]))"/>
                <div class="tc-solution">
                    <t t-set="sol_es" t-value="((request.env.lang or '')[:2] == 'es')"/>
                <t t-set="sol_tile" t-value="{'Leader Pins &amp; Bushings': '/tooling_components_theme/static/src/img/categories/tc_category_leader-pins_44.webp', 'Support Pillars': '/tooling_components_theme/static/src/img/categories/tc_category_support-pillars_75.webp', 'Mold Components': '/tooling_components_theme/static/src/img/categories/tc_category_mold-components_39.webp', 'Springs &amp; Accessories': '/tooling_components_theme/static/src/img/categories/tc_category_die-springs_66.webp', 'Punches, Die Sets &amp; Fasteners': '/tooling_components_theme/static/src/img/categories/tc_category_punches-and-dies_13.webp', 'Ejector Pins': '/tooling_components_theme/static/src/img/categories/tc_category_ejector-pins.webp'}.get(sol[0])"/>
                <a t-if="sol_tile" t-att-href="sol_url" class="tc-solution-img tc-solution-tile"><img t-att-src="sol_tile.replace('.webp', '_es.webp') if sol_es else sol_tile" t-att-alt="sol[4] if sol_es else sol[0]" loading="lazy" decoding="async"/></a>
                <a t-else="" t-att-href="sol_url" class="tc-solution-img" t-out="sol[4] if sol_es else sol[0]"/>
                    <div class="tc-solution-body">
                        <h3><a t-att-href="sol_url" t-out="sol[4] if sol_es else sol[0]"/></h3>
                        <p t-out="sol[5] if sol_es else sol[1]"/>
                        <a t-att-href="sol_url" class="tc-link" t-out="('Solicitar cotización →' if sol_es else 'Request a quote →') if sol[2] == '/quote' else ('Ver catálogo →' if sol_es else 'Browse catalog →')"/>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <template id="tc_solutions" name="TC Solutions">
        <t t-call="website.layout">
            <t t-set="additional_title">Solutions</t>
            <div id="wrap" class="oe_structure o_tc_page">
                <t t-call="tooling_components_theme.tc_breadcrumb"><t t-set="crumb">Solutions</t></t>
                <div class="container tc-page-header">
                    <h1>Solutions for Mold Makers &amp; Stamping Plants</h1>
                    <p class="tc-lead">Ten catalog lines covering the full mold &amp; die component spectrum — from a single ejector pin to complete die sets.</p>
                </div>
                <section class="tc-section pt-0">
                    <div class="container">
                        <div class="tc-section-head"><span class="tc-kicker">Product lines</span><h2>Browse by Solution</h2></div>
                        <t t-call="tooling_components_theme.tc_solution_cards"/>
                    </div>
                </section>
                <section class="tc-section pt-0">
                    <div class="container">
                        <div class="tc-section-head"><span class="tc-kicker">Industries</span><h2>Industries We Serve</h2></div>
                        <div class="tc-grid-3">
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_injection-molding_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_injection-molding.webp'" alt="Injection Molding" loading="lazy" decoding="async"/><h3>Injection Molding</h3><p>Ejector, alignment and cooling components for high-cycle molds.</p></div>
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_metal-stamping_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_metal-stamping.webp'" alt="Metal Stamping" loading="lazy" decoding="async"/><h3>Metal Stamping</h3><p>Die springs, punches and guide sets for progressive dies.</p></div>
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_die-casting_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_die-casting.webp'" alt="Die Casting" loading="lazy" decoding="async"/><h3>Die Casting</h3><p>Hot-work steel components that hold tolerance under heat.</p></div>
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_automotive_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_automotive.webp'" alt="Automotive" loading="lazy" decoding="async"/><h3>Automotive</h3><p>PPAP-ready supply for tier suppliers and tool rooms.</p></div>
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_medical-packaging_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_medical-packaging.webp'" alt="Medical &amp; Packaging" loading="lazy" decoding="async"/><h3>Medical &amp; Packaging</h3><p>Clean-room grade pins and precision alignment.</p></div>
                            <div class="tc-card tc-industry-card"><img class="tc-industry-tile" t-att-src="'/tooling_components_theme/static/src/img/categories/tc_industry_tool-die-shops_es.webp' if ((request.env.lang or '')[:2] == 'es') else '/tooling_components_theme/static/src/img/categories/tc_industry_tool-die-shops.webp'" alt="Tool &amp; Die Shops" loading="lazy" decoding="async"/><h3>Tool &amp; Die Shops</h3><p>Same-day quotes and orders packed per BOM.</p></div>
                        </div>
                    </div>
                </section>
                <section class="tc-cta-band">
                    <div class="container"><div class="tc-flex">
                        <div><h2>Not Sure Which Part You Need?</h2><p>Send the application or the part you are replacing — our team will specify and quote it the same business day.</p></div>
                        <a href="/quote" class="tc-btn-gold">Request a Quote</a>
                    </div></div>
                </section>
            </div>
        </t>
    </template>

    <!-- Home ============================================================= -->
    <template id="tc_home" name="Tooling Components Home">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'homepage'"/>
            <t t-set="additional_title">Home</t>
            <div id="wrap" class="oe_structure o_tc_page">
                <section class="tc-hero">
                    <div class="container">
                        <h1>Forged &amp; Molded.<br/><span class="tc-gold">Built for Zero-Failure Reliability.</span></h1>
                        <p class="tc-subhead">Tooling Components supplies precision ejector pins, leader pins, die springs and mold &amp; die components to North American mold makers and stamping plants. Family-owned since 1987, veteran-owned since 2023 — same-day quotes on every RFQ.</p>
                        <div class="tc-ctas">
                            <a href="/quote" class="tc-btn-gold">Request a Quote</a>
                            <a href="/shop" class="tc-btn-outline">Browse Products</a>
                        </div>
                        <div class="tc-hero-meta">15,000+ SKUs In Stock · Same-Day Shipping On Standard Sizes · Family-Owned Since 1987 · Veteran-Owned Since 2023</div>
                    </div>
                </section>
                <section class="tc-section">
                    <div class="container">
                        <div class="tc-section-head">
                            <span class="tc-kicker">Why Tooling Components</span>
                            <h2>Why Tooling Components</h2>
                            <p class="tc-lead">Four reasons engineers keep our part numbers in their BOMs.</p>
                        </div>
                        <div class="tc-grid-4">
                            <div class="tc-card"><div class="tc-icon">±</div><h3>Precision Tolerances</h3><p>Centerless-ground diameters held to ±0.0002″. Inch, DIN and JIS standards, with certified dimensional reports on request.</p></div>
                            <div class="tc-card"><div class="tc-icon">15K</div><h3>In-Stock Availability</h3><p>Live stock status on every part — 15,000+ SKUs on the shelf and no backorder surprises on the shop floor.</p></div>
                            <div class="tc-card"><div class="tc-icon">VET</div><h3>Veteran-Owned</h3><p>Family-owned since 1987 and veteran-owned since 2023. Precision, accountability and mission-focus on every order — delivered per your BOM, labeled and ready.</p></div>
                            <div class="tc-card"><div class="tc-icon">24h</div><h3>Same-Day Quotes</h3><p>Submit a print or BOM and receive a detailed, itemized quote the same business day. No runaround, no waiting.</p></div>
                        </div>
                    </div>
                </section>
                <section class="tc-section pt-0" id="solutions"><span id="industries" class="tc-anchor"/>
                    <div class="container">
                        <div class="tc-section-head">
                            <span class="tc-kicker">Solutions</span>
                            <h2>Product Categories</h2>
                            <p class="tc-lead">Ten catalog lines covering the full mold &amp; die component spectrum — from a single ejector pin to complete die sets.</p>
                        </div>
                        <t t-call="tooling_components_theme.tc_solution_cards"/>
                    </div>
                </section>
                <section class="tc-trust">
                    <div class="container"><div class="tc-flex">
                        <div>
                            <h2>Precision You Can Specify With Confidence.</h2>
                            <p>Family-owned since 1987, veteran-owned since 2023. Dimensional inspection reports, material certificates and CAD files available on request.</p>
                        </div>
                        <div class="tc-badges"><span class="tc-big-badge">Est. 1987</span><span class="tc-big-badge">Veteran-Owned</span></div>
                    </div></div>
                </section>
                <section class="tc-stats">
                    <div class="container"><div class="tc-grid-4">
                        <div class="tc-stat"><div class="num">15,000+</div><div class="lbl">SKUs In Stock</div></div>
                        <div class="tc-stat"><div class="num">1987</div><div class="lbl">Veteran-Owned Since</div></div>
                        <div class="tc-stat"><div class="num">Same-Day</div><div class="lbl">Quote Response</div></div>
                        <div class="tc-stat"><div class="num">Per BOM</div><div class="lbl">Labeled &amp; Packed Orders</div></div>
                    </div></div>
                </section>
                <section class="tc-section">
                    <div class="container">
                        <div class="tc-section-head">
                            <span class="tc-kicker">Technical Resources</span>
                            <h2>Technical Resources</h2>
                            <p class="tc-lead">Application notes from our engineering team — written for mold makers and die designers who need answers fast.</p>
                        </div>
                        <t t-set="tc_posts" t-value="request.env['blog.post'].search([('website_published', '=', True), ('blog_id.website_id', 'in', [False, website.id])], order='post_date desc', limit=3)"/>
                        <div class="tc-grid-3">
                            <a t-foreach="tc_posts" t-as="post" t-att-href="post.website_url" class="tc-kb-item">
                                <span class="tc-tag" t-if="post.tag_ids" t-out="post.tag_ids[0].name"/>
                                <h3 t-out="post.name"/>
                                <p t-out="(post.subtitle or '').replace('&amp;mdash;', '—').replace('&amp;ndash;', '–').replace('&amp;nbsp;', ' ').replace('&amp;amp;', '&amp;')"/>
                            </a>
                        </div>
                        <p class="mt-3"><a href="/blog" class="tc-link">All technical articles →</a></p>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- About ============================================================ -->
    <template id="tc_about" name="About Tooling Components">
        <t t-call="website.layout">
            <t t-set="additional_title">About Tooling Components</t>
            <div id="wrap" class="oe_structure o_tc_page">
                <t t-call="tooling_components_theme.tc_breadcrumb"><t t-set="crumb">About Tooling Components</t></t>
                <div class="container tc-page-header">
                    <h1>About Tooling Components</h1>
                    <p class="tc-lead">Family-owned since 1987, veteran-owned since 2023. Precision components for molds and dies, built on the belief that a tooling supplier should be measured by the molds it keeps running.</p>
                </div>
                <section class="tc-band">
                    <div class="container">
                        <h2>Forged in 1987. <span class="tc-gold">Machined to Zero-Failure Standards.</span></h2>
                    </div>
                </section>
                <section class="tc-section">
                    <div class="container"><div class="tc-story">
                        <div>
                            <span class="tc-kicker">Our Story</span>
                            <h2>A Legacy of Precision Since 1987</h2>
                            <p>Tooling Components was founded in <strong>1987</strong> on a simple, demanding standard: a mold component either meets print, or it does not ship. That standard still governs every pin, bushing, pillar and spring we stock.</p>
                            <p>Our team applies the same rigor to a <strong>±0.0002″ ground diameter</strong> as to a full die set — because a mold down on the floor costs a plant thousands an hour.</p>
                            <p>From <strong>8349 West High St., Union City, PA</strong>, we hold <strong>15,000+ SKUs</strong> in stock and quote the same business day — inch, DIN and JIS, standard or machined to your print.</p>
                        </div>
                        <aside class="tc-card tc-timeline-card">
                            <h3>Company Timeline</h3>
                            <ul class="tc-timeline">
                                <li><b>1987</b><span>Founded on a standard of zero-failure precision.</span></li>
                                <li><b>Quality</b><span>Documented inspection, dimensional reports and traceability on every order.</span></li>
                                <li><b>Today — Tooling Components LLC</b><span>15,000+ SKUs serving mold makers and stamping plants across North America.</span></li>
                                <li><b>Every Day</b><span>Same-day quotes, orders labeled and packed per BOM, ready for the bench.</span></li>
                            </ul>
                        </aside>
                    </div></div>
                </section>
                <section class="tc-mission">
                    <div class="container">
                        <blockquote>"Keep mission-critical molds and dies running — with components that meet print, every time."</blockquote>
                        <div class="attr">The Tooling Components Mission</div>
                    </div>
                </section>
                <section class="tc-section">
                    <div class="container">
                        <div class="tc-section-head">
                            <span class="tc-kicker">The Difference</span>
                            <h2>Talk to a Real Engineer</h2>
                            <p class="tc-lead">Send us a print or a BOM. If we cannot hold a tolerance, we say so before we quote — not after the mold is down.</p>
                        </div>
                        <div class="tc-grid-3">
                            <div class="tc-card"><div class="tc-icon">EN</div><h3>Engineers on the Phone</h3><p>Tolerance classes, tool steels, nitriding and fits — our team speaks your language.</p></div>
                            <div class="tc-card"><div class="tc-icon">STD</div><h3>Inch · DIN · JIS</h3><p>Cross-standard equivalents so you are never locked into one supplier or a sole-source lead time.</p></div>
                            <div class="tc-card"><div class="tc-icon">BOM</div><h3>Built Around Your BOM</h3><p>Orders labeled and packed per BOM so the right part reaches the right bench, first time.</p></div>
                        </div>
                    </div>
                </section>
                <section class="tc-section pt-0">
                    <div class="container">
                        <div class="tc-section-head">
                            <span class="tc-kicker">Certifications</span>
                            <h2>Certifications &amp; Capability</h2>
                        </div>
                        <div class="tc-grid-3">
                            <div class="tc-card"><div class="tc-seal">QA</div><h3>Documented Inspection</h3><p>Dimensional inspection reports available on request.</p></div>
                            <div class="tc-card"><div class="tc-seal">VET</div><h3>Family-Owned Since 1987</h3><p>Founded in 1987 by the Bowes family and veteran-owned since 2023 - still run on standards of precision and accountability.</p></div>
                            <div class="tc-card"><div class="tc-seal">CAD</div><h3>CAD &amp; Material Certs</h3><p>CAD files, material certificates and dimensional reports available with your order.</p></div>
                        </div>
                    </div>
                </section>
                <section class="tc-section pt-0">
                    <div class="container">
                        <div class="tc-section-head"><span class="tc-kicker">Values</span><h2>What We Stand On</h2></div>
                        <div class="tc-grid-4">
                            <div class="tc-card"><h3>Precision</h3><p>Ground, inspected and certified to print — no exceptions.</p></div>
                            <div class="tc-card"><h3>Reliability</h3><p>Live stock status and same-day shipping you can plan a tool build around.</p></div>
                            <div class="tc-card"><h3>Integrity</h3><p>If we cannot hold the tolerance, we tell you before we quote.</p></div>
                            <div class="tc-card"><h3>Service</h3><p>A veteran-owned commitment to the people who build and run the tools.</p></div>

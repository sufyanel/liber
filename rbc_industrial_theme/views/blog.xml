<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Knowledge Base index: compact list (default) or cards, no author, short text -->
    <template id="rbc_blog_index" inherit_id="website_blog.blog_post_short" name="RBC Industrial: Knowledge Base" priority="60">
        <xpath expr="//div[@id='o_wblog_posts_loop_container']" position="before">
            <div t-if="website.x_rbc_theme_active" class="rbc-kb-head">
                <div>
                    <h1>Knowledge Base</h1>
                    <p>Technical intelligence for plant operators, maintenance managers, and procurement officers — written by RBC Industrial's engineers.</p>
                </div>
                <t t-set="rbc_view" t-value="request.params.get('view') == 'cards' and 'cards' or 'list'"/>
                <div class="rbc-view-toggle" role="group" aria-label="Layout">
                    <a t-att-href="request.httprequest.path" t-attf-class="#{'active' if rbc_view == 'list' else ''}" title="List view"><i class="fa fa-th-list"/></a>
                    <a t-att-href="request.httprequest.path + '?view=cards'" t-attf-class="#{'active' if rbc_view == 'cards' else ''}" title="Card view"><i class="fa fa-th-large"/></a>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='website_blog.posts_loop']" position="replace">
            <t t-if="website.x_rbc_theme_active">
                <div t-if="not posts" class="rbc-muted py-4">No articles found.</div>
                <div t-attf-class="rbc-kb-#{rbc_view}">
                    <article t-foreach="posts" t-as="post" class="rbc-kb-row">
                        <t t-set="cp" t-value="post.cover_properties or ''"/><t t-set="thumb" t-value="cp.split('url(')[1].split(')')[0].replace('&quot;', '').replace(&quot;'&quot;, '').replace('\\', '') if 'url(' in cp else ''"/>
                        <t t-set="pc" t-value="post.content or ''"/>
                        <t t-set="img_at" t-value="pc.find('&lt;img')"/>
                        <t t-if="not thumb and img_at &gt;= 0 and 'src=&quot;' in pc[img_at:img_at + 600]" t-set="thumb" t-value="pc[img_at:img_at + 600].split('src=&quot;')[1].split('&quot;')[0]"/>
                        <a t-att-href="post.website_url" class="rbc-kb-thumb">
                            <img t-if="thumb" t-att-src="thumb" t-att-alt="post.name" loading="lazy" class="rbc-kb-thumb-img"/>
                            <span t-attf-class="rbc-kb-brief #{'rbc-kb-brief-fallback' if thumb else ''}">
                                <span class="rbc-kb-brief-top"><b>R</b><em t-out="'Ficha técnica' if ((request.env.lang or '')[:2] == 'es') else 'Technical brief'"/></span>
                                <strong t-out="post.name"/>
                                <i/><i/>
                            </span>
                        </a>
                        <div class="rbc-kb-body">
                            <div class="rbc-kb-tags"><span t-foreach="post.tag_ids[:2]" t-as="tag" class="rbc-tag" t-out="tag.name"/></div>
                            <h3><a t-att-href="post.website_url" t-out="post.name"/></h3>
                            <p t-if="rbc_view == 'cards' and post.subtitle" class="rbc-kb-sub" t-out="(post.subtitle or '').replace('&amp;mdash;', '—').replace('&amp;ndash;', '–').replace('&amp;nbsp;', ' ').replace('&amp;amp;', '&amp;')"/>
                        </div>
                        <time class="rbc-kb-date" t-out="post.post_date" t-options="{'widget': 'date'}"/>
                    </article>
                </div>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- Blog post: compact title block instead of the full-width cover band and author bar -->
    <template id="rbc_blog_post" inherit_id="website_blog.blog_post_complete" name="RBC Industrial: blog post" priority="60">
        <xpath expr="//section[@id='o_wblog_post_top']" position="replace">
            <t t-if="website.x_rbc_theme_active">
                <section id="o_wblog_post_top" class="rbc-post-head">
                    <div class="container">
                        <nav class="rbc-breadcrumbs"><a href="/">Home</a><span class="sep">›</span><a href="/blog">Knowledge Base</a></nav>
                        <div class="rbc-kb-tags"><span t-foreach="blog_post.tag_ids" t-as="tag" class="rbc-tag" t-out="tag.name"/></div>
                        <h1 t-field="blog_post.name" id="o_wblog_post_name" placeholder="Blog Post Title"/>
                        <div t-field="blog_post.subtitle" id="o_wblog_post_subtitle" class="rbc-post-sub" placeholder="Subtitle"/>
                        <div class="rbc-post-actions">
                        </div>
                        <div class="rbc-print-brand">
                            <img src="/rbc_industrial_theme/static/src/img/rbc_logo.png" alt="RBC Industrial"/>
                            <span>Knowledge Base · www.rbc-industrial.com</span>
                        </div>
                    </div>
                </section>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>


    <!-- Print button that does not depend on the post header being replaced -->
    <template id="rbc_blog_print_fallback" inherit_id="website_blog.blog_post_complete" name="RBC: print button" priority="70">
        <xpath expr="//section[@id='o_wblog_post_main']" position="before">
            <div t-if="website.x_rbc_theme_active" class="container rbc-print-bar">
                <button type="button" class="rbc-print-btn" onclick="window.print()"><i class="fa fa-print"/> Print / Save as PDF</button>
            </div>
            <div t-if="website.x_rbc_theme_active" class="rbc-print-brand">
                <img src="/rbc_industrial_theme/static/src/img/rbc_logo.png" alt=""/>
                <span>Knowledge Base &#183; www.rbc-industrial.com</span>
            </div>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website > Configuration > Websites > RBC Industrial -->
    <record id="view_website_form_rbc" model="ir.ui.view">
        <field name="name">website.form.rbc.industrial</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="RBC Industrial Theme" name="rbc_theme">
                    <field name="x_rbc_theme_active"/>
                    <field name="x_rbc_logo" widget="image" class="oe_avatar" invisible="not x_rbc_theme_active"/>
                    <field name="x_rbc_quote_form_url" widget="url" invisible="not x_rbc_theme_active"
                           placeholder="https://api.leadconnectorhq.com/widget/form/... (empty = Odoo quote form)"/>
                    <field name="x_rbc_line_card_url" widget="url" invisible="not x_rbc_theme_active"
                           placeholder="https://www.rbc-industrial.com/web/content/... (PDF)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- html flag + fonts + LocalBusiness schema (RBC website only) -->
    <template id="rbc_layout_head" inherit_id="website.layout" name="RBC Industrial: head" priority="60">
        <xpath expr="//html" position="attributes">
            <attribute name="t-att-data-rbc-theme">'1' if (website and website.x_rbc_theme_active) else None</attribute>
            <attribute name="t-att-data-rbc-version">'17.0.10.1.0' if (website and website.x_rbc_theme_active) else None</attribute>
        </xpath>
        <xpath expr="//head" position="inside">
            <t t-if="website and website.x_rbc_theme_active">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <t t-if="website.x_rbc_quote_form_url">
                    <link rel="preconnect" href="https://api.leadconnectorhq.com"/>
                    <link rel="preconnect" href="https://link.msgsndr.com"/>
                    <link rel="dns-prefetch" href="https://api.leadconnectorhq.com"/>
                </t>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap"/>
                <!-- hreflang fallback: Odoo only emits alternates when the literal request URL equals the
                     canonical URL (website._is_canonical_url). Behind a proxy that hands Odoo a different
                     scheme/host for this site, that check fails and no alternates are emitted even though the
                     canonical tag is correct. Emit the same reciprocal set from the canonical URLs, only when
                     Odoo's own block produced nothing, so there are never duplicates. -->
                <t t-if="request and request.is_frontend_multilang and website.is_public_user() and len(website.language_ids) &gt; 1 and not alternate_languages">
                    <meta name="rbc-hreflang" content="fallback: request URL did not match canonical URL"/>
                    <t t-set="rbc_shorts" t-value="[l.code.split('_')[0] for l in website.language_ids]"/>
                    <t t-foreach="website.language_ids" t-as="rbc_lg">
                        <t t-set="rbc_short" t-value="rbc_lg.code.split('_')[0]"/>
                        <link rel="alternate" t-att-hreflang="rbc_short if rbc_shorts.count(rbc_short) == 1 else rbc_lg.code.replace('_', '-').lower()"
                              t-att-href="website._get_canonical_url_localized(lang=rbc_lg, canonical_params=canonical_params)"/>
                    </t>
                    <link rel="alternate" hreflang="x-default" t-att-href="website._get_canonical_url_localized(lang=website.default_lang_id, canonical_params=canonical_params)"/>
                </t>
                <script type="application/ld+json">{"@context": "https://schema.org", "@type": "LocalBusiness", "name": "RBC Industrial LLC", "description": "Service-disabled veteran-owned distributor of mechanical power transmission equipment, bearings and MRO supplies in El Paso, Texas.", "url": "https://www.rbc-industrial.com", "telephone": "+1-915-845-8188", "faxNumber": "+1-915-845-8183", "email": "Sales@rbc-industrial.com", "foundingDate": "1946", "address": {"@type": "PostalAddress", "streetAddress": "3950 Doniphan Dr. Ste P", "addressLocality": "El Paso", "addressRegion": "TX", "postalCode": "79922", "addressCountry": "US"}, "areaServed": ["El Paso", "Texas", "Ciudad Juarez", "New Mexico"]}</script>
            </t>
        </xpath>
    </template>

    <!-- Header: emergency bar + dark nav with logo, menu, badges, search, cart, account -->
    <template id="rbc_layout_header" inherit_id="website.layout" name="RBC Industrial: header" priority="60">
        <xpath expr="//header[@id='top']" position="replace">
            <t t-if="website and website.x_rbc_theme_active">
                <header t-if="not no_header" id="top" data-anchor="true" data-name="Header" class="o_rbc_header o_no_autohide_menu">
                    <div class="rbc-emergency-bar">
                        <span class="rbc-pulse"/>
                        LINE DOWN EMERGENCY? SAME-DAY DELIVERY FROM EL PASO —
                        <a href="tel:+19158458188">CALL 915-845-8188</a>
                    </div>
                    <nav class="navbar navbar-expand-lg rbc-navbar">
                        <div class="container">
                            <a href="/" class="navbar-brand rbc-brand" aria-label="RBC Industrial home">
                                <img t-if="website.x_rbc_logo" t-att-src="image_data_uri(website.x_rbc_logo)" alt="RBC Industrial" class="rbc-logo"/>
                                <img t-else="" src="/rbc_industrial_theme/static/src/img/rbc_logo.png" alt="RBC Industrial" class="rbc-logo"/>
                            </a>
                            <button class="navbar-toggler rbc-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#rbcNav" aria-controls="rbcNav" aria-expanded="false" aria-label="Toggle navigation">
                                <i class="fa fa-bars"/>
                            </button>
                            <div class="collapse navbar-collapse" id="rbcNav">
                                <ul id="top_menu" class="navbar-nav ms-auto rbc-menu" role="menu">
                                    <t t-set="rbc_path" t-value="request.httprequest.path"/>
                                    <li class="nav-item" role="presentation">
                                        <a href="/" role="menuitem" t-attf-class="nav-link #{'active' if rbc_path == '/' else ''}">Home</a>
                                    </li>
                                    <t t-foreach="website.menu_id.child_id" t-as="menu">
                                        <li t-if="menu.is_visible" class="nav-item" role="presentation">
                                            <a t-att-href="menu.url" role="menuitem"
                                               t-attf-class="nav-link #{'active' if (menu.url and '#' not in menu.url and menu.url != '/' and rbc_path.startswith(menu.url)) else ''}"
                                               t-out="menu.name"/>
                                        </li>
                                    </t>
                                </ul>
                                <div class="rbc-cert-badges d-flex">
                                    <span class="rbc-cert-badge">SDVOSB</span>
                                    <span class="rbc-cert-badge">TX HUB</span>
                                </div>
                                <a href="/quote" class="rbc-btn-gold rbc-btn-sm rbc-header-cta d-none d-lg-inline-block">Request a Quote</a>
                                <ul class="navbar-nav rbc-tools align-items-lg-center">
                                    <li t-if="website.x_rbc_line_card_url" class="nav-item">
                                        <a t-att-href="website.x_rbc_line_card_url" target="_blank" rel="noopener" class="nav-link rbc-linecard" title="Download Line Card (PDF)">
                                            <i class="fa fa-download"/> <span class="d-lg-none d-xl-inline">Line Card</span>
                                        </a>
                                    </li>
                                    <li t-if="len(website.language_ids) &gt; 1" class="nav-item rbc-lang">
                                        <t t-foreach="website.language_ids" t-as="lg">
                                            <a t-att-href="url_for(request.httprequest.path, lang_code=lg.url_code)"
                                               t-attf-class="js_change_lang rbc-lang-link #{'active' if lg.code == request.env.lang else ''}" t-att-data-lang="lg.code"
                                               t-att-data-url_code="lg.url_code" t-att-title="lg.name" t-out="lg.iso_code[:2].upper()"/>
                                        </t>
                                    </li>
                                                                        <li class="nav-item">
                                        <a href="/shop/cart" class="nav-link rbc-cart" title="Cart" aria-label="Cart">
                                            <i class="fa fa-shopping-cart"/>
                                            <span class="rbc-cart-qty my_cart_quantity" t-out="request.session.get('website_sale_cart_quantity') or 0"/>
                                        </a>
                                    </li>
                                    <t t-call="portal.placeholder_user_sign_in">
                                        <t t-set="_link_class" t-valuef="nav-link"/>
                                    </t>
                                    <t t-call="portal.user_dropdown">
                                        <t t-set="_user_name" t-value="True"/>
                                        <t t-set="_item_class" t-valuef="nav-item dropdown"/>
                                        <t t-set="_link_class" t-valuef="nav-link"/>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </nav>
                </header>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- Footer -->
    <template id="rbc_layout_footer" inherit_id="website.layout" name="RBC Industrial: footer" priority="60">
        <xpath expr="//footer[@id='bottom']" position="replace">
            <t t-if="website and website.x_rbc_theme_active">
                <footer t-if="not no_footer" id="bottom" data-anchor="true" data-name="Footer" class="rbc-footer">
                    <div class="container">
                        <div class="rbc-footer-grid">
                            <div>
                                <h4>RBC Industrial LLC</h4>
                                <p>Service-disabled veteran-owned distributor of mechanical power transmission equipment,
                                    bearings, and MRO supplies. Founded 1946 — delivering the right product at the right time, every time.</p>
                                <p>3950 Doniphan Dr. Ste P, El Paso, Texas 79922<br/>
                                    Phone: <a href="tel:+19158458188">915-845-8188</a> | Fax: 915-845-8183<br/>
                                    <a href="mailto:Sales@rbc-industrial.com">Sales@rbc-industrial.com</a></p>
                                <div class="rbc-cert-line">
                                    <span class="rbc-cert-badge rbc-cert-badge-dark">SDVOSB Certified</span>
                                    <span class="rbc-cert-badge rbc-cert-badge-dark">Texas HUB Certified</span>
                                </div>
                            </div>
                            <div>
                                <h4>Solutions</h4>
                                <t t-set="rbc_cats" t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False)], limit=4)"/>
                                <p t-foreach="rbc_cats" t-as="cat"><a t-attf-href="/shop/category/#{slug(cat)}" t-out="cat.name"/></p>
                                <p><a href="/contactus">Line Down Support</a></p>
                            </div>
                            <div>
                                <h4>Resources</h4>
                                <p><a href="/blog">Knowledge Base</a></p>
                                <p><a href="/about-us">About RBC Industrial</a></p>
                                <p t-if="website.x_rbc_line_card_url"><a t-att-href="website.x_rbc_line_card_url" target="_blank" rel="noopener"><i class="fa fa-download"/> Download Line Card (PDF)</a></p>
                                <p><a href="/quote">Request Quote</a></p>
                            </div>
                        </div>
                        <div class="rbc-copyright">© <t t-out="datetime.date.today().year"/> RBC Industrial LLC. All rights reserved.</div>
                    </div>
                </footer>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RBC Blog Index & Knowledge Base Enhancements -->
    <template id="blog_index_rbc" inherit_id="website_blog.index" name="RBC Blog Index" priority="50">
        <xpath expr="//*[@id='wrap']" position="attributes">
            <attribute name="t-attf-class">#{'o_rbc_blog_wrap' if (request and request.website and (request.website.name == 'RBC Industrial' or request.website.id == 4)) else ''}</attribute>
        </xpath>

        <!-- Inject RBC Technical Knowledge Base Header Banner inside wrap -->
        <xpath expr="//*[@id='wrap']" position="after">
            <t t-if="request and request.website and (request.website.name == 'RBC Industrial' or request.website.id == 4)">
                <div class="container mt-4">
                    <div class="rbc-blog-banner bg-dark text-white p-4 p-md-5 rounded-3 mb-4 shadow-sm">
                        <span class="badge bg-warning text-dark fw-bold px-3 py-2 text-uppercase mb-3">Field-Tested Engineering Intelligence</span>
                        <h1 class="display-5 fw-extrabold text-white mb-2">Technical Knowledge Base</h1>
                        <p class="lead text-light max-w-700 mb-4">Maintenance guides, root cause failure analyses, and cross-border logistics strategies written by RBC Industrial application engineers.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-primary text-warning px-3 py-2">Bearings &amp; Motion</span>
                            <span class="badge bg-primary text-warning px-3 py-2">Motors &amp; Drives</span>
                            <span class="badge bg-primary text-warning px-3 py-2">Hydraulics</span>
                            <span class="badge bg-primary text-warning px-3 py-2">Juárez Maquiladora Logistics</span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>

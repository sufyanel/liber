<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Income Statement: one dashboard per company and year, like the Threshold Dashboard. The budget is entered on the dashboard itself. -->
    <record id="model_x_isr_dashboard" model="ir.model">
        <field name="name">Income Statement Dashboard</field>
        <field name="model">x_isr_dashboard</field>
        <field name="order">id</field>
    </record>
    <record id="model_x_isr_line" model="ir.model">
        <field name="name">Income Statement Line</field>
        <field name="model">x_isr_line</field>
        <field name="order">id</field>
    </record>
    <record id="model_x_isr_period" model="ir.model">
        <field name="name">Income Statement Period</field>
        <field name="model">x_isr_period</field>
        <field name="order">id</field>
    </record>
    <record id="model_x_isr_value" model="ir.model">
        <field name="name">Income Statement Figure</field>
        <field name="model">x_isr_value</field>
        <field name="order">id</field>
    </record>
    <record id="model_x_isr_part" model="ir.model">
        <field name="name">Income Statement Subtotal Part</field>
        <field name="model">x_isr_part</field>
        <field name="info">What a calculated line is made of, for one period: one row per account-based line.</field>
    </record>

    <record id="field_x_isr_dashboard__x_name" model="ir.model.fields">

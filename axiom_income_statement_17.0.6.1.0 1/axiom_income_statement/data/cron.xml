<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_isr_refresh" model="ir.cron">
        <field name="name">Income Statement Dashboard: nightly refresh</field>
        <field name="model_id" ref="model_x_isr_dashboard"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
dashboards = env['x_isr_dashboard'].sudo().search([])
if dashboards:
    env.ref('axiom_income_statement.action_isr_refresh').sudo().with_context(
        active_model='x_isr_dashboard', active_id=dashboards[0].id, active_ids=dashboards.ids).run()
]]></field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.today() + timedelta(days=1)).strftime('%Y-%m-%d 08:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend: Sales tab, after eCommerce Shop group -->
    <record model="ir.ui.view" id="product_template_form_view_seo_description">
        <field name="name">product.template.seo.description</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']/group[@name='shop']" position="after">
                <group string="SEO Description" name="seo_group" invisible="not sale_ok" colspan="2">
                    <field name="seo_description" widget="html" nolabel="1" colspan="2" options="{'collaborative': False, 'resizable': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Website: Render SEO description after product_option_block (after Add to wishlist) -->
    <template id="product_seo_description" inherit_id="website_sale.product" name="Product SEO Description">
        <xpath expr="//div[@id='product_option_block']" position="after">
            <div t-if="product.seo_description" t-out="product.seo_description" class="o_seo_description mt-2"/>
        </xpath>
    </template>

</odoo>

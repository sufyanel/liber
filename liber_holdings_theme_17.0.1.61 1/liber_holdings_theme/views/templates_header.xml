<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Single clean header CTA: Request a Quote (solid Liber Red, removes redundant second Contact button) -->
    <template id="header_call_to_action_liber"
              inherit_id="website.header_call_to_action"
              name="Liber Header CTA"
              priority="50">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a t-att-href="'/request-quote' if (website and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active))) else '/quote'" class="oe_unremovable btn btn-primary btn_cta o_liber_header_quote_btn">Request a Quote</a>
        </xpath>
    </template>

    <!-- Desktop cart link: shown only for non-public users on transactional sites -->
    <template id="header_cart_liber"
              inherit_id="website.template_header_default"
              name="Liber Desktop Header Cart"
              priority="60">
        <xpath expr="//ul[hasclass('navbar-nav')]/t[@t-call='portal.placeholder_user_sign_in']"
               position="before">
            <t t-if="not request.env.user._is_public() and not ('liber' in (website.name or '').lower())" t-call="website_sale.header_cart_link">
                <t t-set="_icon" t-value="True"/>
                <t t-set="_text" t-value="True"/>
                <t t-set="_item_class" t-value="'o_liber_header_cart'"/>
                <t t-set="_link_class"
                   t-value="'btn o_liber_cart_link position-relative d-flex align-items-center gap-2'"/>
                <t t-set="_icon_wrap_class" t-value="'o_liber_cart_icon position-relative'"/>
                <t t-set="_badge_class"
                   t-value="'position-absolute top-0 start-100 translate-middle rounded-pill'"/>
                <t t-set="_text_class" t-value="'o_liber_cart_text'"/>
            </t>
        </xpath>
    </template>

    <!-- Hide stock mobile/desktop cart chrome on Liber Holdings -->
    <template id="header_cart_login_required"
              inherit_id="website_sale.header_cart_link"
              name="Liber Cart Login Required"
              priority="50">
        <xpath expr="//t[@t-set='show_cart']" position="after">
            <t t-set="show_cart" t-value="show_cart and not request.env.user._is_public() and not ('liber' in (website.name or '').lower())"/>
        </xpath>
    </template>

    <!-- No site search on Liber Holdings (Dale, 9 Oct 2026): its results would list products. Other websites keep it. -->
    <template id="header_search_box_liber" inherit_id="website.header_search_box" name="Liber: no header search" priority="60">
        <xpath expr="//li" position="attributes">
            <attribute name="t-if">not (website and 'liber' in (website.name or '').lower() and 'industrial' not in (website.name or '').lower() and not (('x_rbc_theme_active' in website and website.x_rbc_theme_active) or ('x_globe_theme_active' in website and website.x_globe_theme_active) or ('x_tc_theme_active' in website and website.x_tc_theme_active) or ('x_tooling_theme_active' in website and website.x_tooling_theme_active)))</attribute>
        </xpath>
    </template>

</odoo>

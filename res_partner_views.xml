<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Partner Form View to add Tier field -->
    <record id="view_partner_form_inherit_tier" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.tier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="tier_id" placeholder="Select Tier..."/>
            </field>
        </field>
    </record>

</odoo>

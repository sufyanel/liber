<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="x_invcmp_dashboard.Dashboard">
        <div class="o_action o_axd_root">
        <div class="o_content o_axd">
            <!-- Header -->
            <div class="o_axd_header">
                <div class="o_axd_title">
                    <div class="o_axd_eyebrow">Customer Revenue</div>
                    <h1>Invoice Comparison</h1>
                    <div class="o_axd_meta" t-if="state.dashboard">
                        <span><i class="fa fa-building-o me-1"/><t t-esc="state.dashboard.x_company_id[1]"/></span>
                        <span><i class="fa fa-calendar me-1"/><t t-esc="years[0]"/> – <t t-esc="state.dashboard.x_year"/></span>
                        <span><i class="fa fa-clock-o me-1"/>Refreshed <t t-esc="refreshedLabel"/></span>
                    </div>
                </div>
                <div class="o_axd_controls" t-if="state.dashboards.length">
                    <select class="form-select o_axd_select" t-on-change="onDashboardChange">
                        <t t-foreach="state.dashboards" t-as="d" t-key="d.id">
                            <option t-att-value="d.id" t-att-selected="d.id === state.dashboardId" t-esc="d.x_name"/>
                        </t>
                    </select>
                    <button class="btn btn-primary o_axd_btn" t-on-click="refresh" t-att-disabled="state.refreshing">
                        <i t-attf-class="fa fa-refresh me-1 #{state.refreshing ? 'fa-spin' : ''}"/>
                        <t t-if="state.refreshing">Refreshing…</t><t t-else="">Refresh</t>
                    </button>
                    <button class="btn btn-light o_axd_btn" t-on-click="download" t-if="params.export_action_id"
                            t-att-disabled="state.downloading or !hasData">
                        <i t-attf-class="fa #{state.downloading ? 'fa-circle-o-notch fa-spin' : 'fa-file-excel-o'} me-1"/>Spreadsheet
                    </button>
                    <button class="btn btn-light o_axd_btn" t-on-click="openSettings" title="Dashboard settings">
                        <i class="fa fa-cog"/>
                    </button>
                </div>
            </div>

            <!-- Empty states -->
            <div class="o_axd_empty" t-if="!state.loading and !state.dashboards.length">
                <i class="fa fa-bar-chart fa-3x"/>
                <h3>No Invoice Comparison dashboard yet</h3>
                <p>Create one per company and year (e.g. RBC Industrial 2026), then click Refresh.</p>
                <button class="btn btn-primary" t-on-click="openSettings">Create a dashboard</button>
            </div>
            <div class="o_axd_empty" t-if="!state.loading and state.dashboards.length and !hasData">
                <i class="fa fa-refresh fa-3x"/>
                <h3>No figures yet</h3>
                <p>Click Refresh to calculate <t t-esc="years[0]"/> to <t t-esc="state.dashboard.x_year"/>.</p>
                <button class="btn btn-primary" t-on-click="refresh" t-att-disabled="state.refreshing">Refresh now</button>
            </div>
            <div class="o_axd_loading" t-if="state.loading"><i class="fa fa-circle-o-notch fa-spin fa-2x"/></div>

            <t t-if="!state.loading and hasData">
                <!-- Period tabs: quarters, full year and Custom. The date range appears only on Custom and
                     recalculates automatically when a date changes (Dale, 23 Oct 2026). -->
                <div class="o_axd_periods">
                    <t t-foreach="standardPeriods" t-as="per" t-key="per.x_code">
                        <button t-attf-class="o_axd_period #{per.x_code === state.selectedCode ? 'active' : ''} #{per.x_is_future and !per.x_budget ? 'future' : ''}"
                                t-att-disabled="per.x_is_future and !per.x_budget" t-on-click="() => this.selectPeriod(per.x_code)">
                            <span class="o_axd_period_code" t-esc="per.x_code"/>
                            <span class="o_axd_period_range"><t t-esc="per.x_date_from.slice(5)"/> → <t t-esc="per.x_date_to.slice(5)"/></span>
                        </button>
                    </t>
                    <button t-attf-class="o_axd_period o_axd_period_custom #{state.selectedCode === 'CUSTOM' ? 'active' : ''}"
                            t-on-click="() => this.selectPeriod('CUSTOM')">
                        <span class="o_axd_period_code">Custom</span>
                        <span class="o_axd_period_range" t-if="customPeriod" t-esc="customPeriod.x_name"/>
                        <span class="o_axd_period_range" t-else="">Choose dates</span>
                    </button>
                    <div class="o_axd_custom" t-if="state.selectedCode === 'CUSTOM'">
                        <div class="o_axd_custom_label"><i class="fa fa-calendar me-1"/>Custom range</div>
                        <div class="o_axd_custom_inputs">
                            <input type="date" class="form-control" t-model="state.customFrom" t-on-change="onDateChange"/>
                            <span>→</span>
                            <input type="date" class="form-control" t-model="state.customTo" t-on-change="onDateChange"/>
                            <span class="o_axd_updating ms-2" t-if="state.applying"><i class="fa fa-circle-o-notch fa-spin me-1"/>Updating…</span>
                        </div>
                    </div>
                </div>

                <!-- KPI cards -->
                <div class="o_axd_kpis">
                    <t t-foreach="kpis" t-as="k" t-key="k.key">
                        <div t-attf-class="o_axd_kpi tone-#{k.tone} #{k.drill ? 'o_axd_click' : ''}" t-att-data-kpi="k.key" t-on-click="() => this.onKpiClick(k)">
                            <div class="o_axd_kpi_label" t-esc="k.label"/>
                            <div class="o_axd_kpi_value" t-esc="k.value"/>
                            <div class="o_axd_kpi_sub" t-esc="k.sub"/>
                            <div t-if="k.delta" t-attf-class="o_axd_kpi_delta #{k.delta.tone}">
                                <t t-esc="k.delta.arrow"/> <t t-esc="k.delta.text"/>
                            </div>
                            <i t-if="k.drill" class="fa fa-external-link o_axd_kpi_link"/>
                        </div>
                    </t>
                </div>

                <div class="o_axd_grid">
                    <div class="o_axd_card span-6">
                        <div class="o_axd_card_head">
                            <div><h3>Year by Year</h3><p><t t-esc="windowLabel"/> in each year · click a bar for its invoices or budget</p></div>
                        </div>
                        <div class="o_axd_chart h-280"><canvas t-ref="years"/></div>
                    </div>
                    <div class="o_axd_card span-6">
                        <div class="o_axd_card_head">
                            <div><h3>Month by Month</h3><p><t t-esc="state.dashboard.x_year"/> against <t t-esc="state.dashboard.x_year - 1"/> · click any bar or point</p></div>
                        </div>
                        <div class="o_axd_chart h-280"><canvas t-ref="months"/></div>
                    </div>

                    <div class="o_axd_card span-8">
                        <div class="o_axd_card_head">
                            <div><h3>Top Customers</h3><p><t t-esc="windowLabel"/> · this year against last · click a bar for the invoices</p></div>
                        </div>
                        <div class="o_axd_chart h-320"><canvas t-ref="top"/></div>
                    </div>
                    <div class="o_axd_card span-4">
                        <div class="o_axd_card_head">
                            <div><h3>Concentration</h3><p>Share of the five largest customers · click a segment</p></div>
                        </div>
                        <div class="o_axd_chart h-280"><canvas t-ref="mix"/></div>
                    </div>

                    <div class="o_axd_card span-12">
                        <div class="o_axd_card_head">
                            <div><h3>What Changed</h3><p><t t-esc="windowLabel"/>: from <t t-esc="state.dashboard.x_year - 1"/> to <t t-esc="state.dashboard.x_year"/> · click a bar for the customers in it</p></div>
                            <div class="o_axd_legend"><span class="dot teal"/>Adds <span class="dot amber"/>Takes away</div>
                        </div>
                        <div class="o_axd_chart h-260"><canvas t-ref="bridge"/></div>
                    </div>

                    <!-- Customer table -->
                    <div class="o_axd_card span-12">
                        <div class="o_axd_card_head">
                            <div>
                                <h3>Customers</h3>
                                <p><t t-esc="windowLabel"/> · new customers shaded (no sales in the same period last year) · click a figure for its invoices, a name for the details</p>
                            </div>
                        </div>
                        <div style="overflow-x:auto">
                            <table class="o_axd_table">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <t t-foreach="years" t-as="y" t-key="y">
                                            <th t-attf-class="text-end #{y === state.dashboard.x_year ? 'sel' : ''}" t-esc="y"/>
                                        </t>
                                        <th class="text-end fy">Budget to come</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="rows" t-as="row" t-key="row.customer.id" t-attf-class="#{row.isNew ? 'new' : ''}">
                                        <td class="o_axd_click" t-on-click="() => this.openCustomerRecord(row)">
                                            <t t-esc="row.customer.x_name"/>
                                            <span t-if="row.isNew" class="o_axd_badge ms-1" title="New: no sales in the same period of the previous year. Use Year to Date to see whether a customer is new this year.">new</span>
                                        </td>
                                        <t t-foreach="row.cells" t-as="c" t-key="c.year">
                                            <td t-attf-class="text-end o_axd_click #{c.negative ? 'neg' : ''} #{c.year === state.dashboard.x_year ? 'sel' : ''}"
                                                t-att-data-customer="row.customer.id" t-att-data-year="c.year"
                                                t-on-click="() => this.openCustomer(row, c.year)">
                                                <t t-esc="c.text"/>
                                                <span t-if="c.growth" t-attf-class="o_axd_sub #{c.growthTone}" t-esc="c.growth"/>
                                            </td>
                                        </t>
                                        <td t-attf-class="text-end fy #{row.budget ? 'o_axd_click' : ''}" t-att-data-drill="row.budget ? 'budget' : null"
                                            t-on-click="() => row.budget and this.openCustomerBudget(row)" t-esc="fmt(row.budget)"/>
                                    </tr>
                                    <tr class="total">
                                        <td>Total</td>
                                        <t t-foreach="totals.cells" t-as="c" t-key="c.year">
                                            <td class="text-end o_axd_click" data-drill="total" t-on-click="() => this.openYear(c.year)">
                                                <t t-esc="c.text"/>
                                                <span t-if="c.growth" class="o_axd_sub" t-esc="c.growth"/>
                                            </td>
                                        </t>
                                        <td class="text-end fy o_axd_click" data-drill="total-budget" t-on-click="() => this.openTotalBudget()" t-esc="totals.budget"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="o_axd_footnote">Posted customer invoices<t t-if="state.dashboard.x_include_refunds"> less credit notes</t>,
                            grouped under the parent customer. The current year adds the budget for months still to come.
                            Settings: Accounting → Configuration → Invoice Comparison Dashboards.</div>
                    </div>
                </div>
            </t>
        </div>
        </div>
    </t>
</templates>
